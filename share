#!/usr/bin/env bash
# share — send folders/files to friends using croc (https://github.com/schollz/croc).
# Requires: croc (https://github.com/schollz/croc)
# a command is an executable in tools/; `share <cmd> --help` prints its header.
set -euo pipefail
command -v croc >/dev/null || { echo "share: needs croc — brew install croc  |  curl https://getcroc.com | bash" >&2; exit 1; }
T="$(dirname "$(readlink -f "$0")")/tools"; export PATH="$T:$PATH"
# once a day, if installed via brew: nudge when outdated
case "$T" in */Cellar/*) st="${TMPDIR:-/tmp}/share-upd"; [ -n "$(find "$st" -mtime -1 2>/dev/null)" ] || { touch "$st"
  [ -z "$(brew outdated --quiet share 2>/dev/null)" ] || echo "share: update available — brew upgrade share" >&2; };; esac
cmd="${1:-}"; [ $# -gt 0 ] && shift
if [ ! -f "$T/$cmd" ]; then
  sed -n '2,3p' "$0" | sed 's/^# //'; echo
  for t in "$T"/*; do printf '  share %-9s %s\n' "$(basename "$t")" "$(sed -n 's/^# desc: //p' "$t")"; done
  exit 1
fi
case "${1:-}" in -h|--help) sed -n '3,/^[^#]/{/^#/!q;s/^# \{0,1\}//p;}' "$T/$cmd"; exit 0;; esac
exec "$T/$cmd" "$@"
