#!/usr/bin/env bash
# desc: who you can share with; invite / accept / add
# usage: share friends                     list
#        share friends invite NAME         pair with NAME: prints a one-time code to tell them
#        share friends accept NAME CODE    other side: receive the secret, register NAME
#        share friends add NAME [SECRET]   register NAME by hand (generates SECRET if omitted)
# Pairing rides croc's PAKE: the code is short, single-use, and safe to say over any channel.
set -euo pipefail
rc="${ZDOTDIR:-$HOME}/.$(basename "${SHELL:-zsh}")rc"
var() { echo "SHARE_SECRET_$(tr 'a-z-' 'A-Z_' <<<"$1")"; }
case "${1:-}" in
  add)
    n="${2:?usage: share friends add NAME [SECRET]}"; s="${3:-$(openssl rand -base64 12 | tr -dc 'a-zA-Z0-9')}"
    grep -q "^export $(var "$n")=" "$rc" 2>/dev/null && { echo "share: $n already in $rc — edit it there" >&2; exit 1; }
    printf 'export %s="%s"\n' "$(var "$n")" "$s" >> "$rc"
    echo "added $n to $rc — run:  source $rc";;
  invite)
    n="${2:?usage: share friends invite NAME}"; me="$(whoami)"
    s="$(openssl rand -base64 12 | tr -dc 'a-zA-Z0-9')"
    out="$(mktemp)"; trap 'rm -f "$out"' EXIT
    croc --yes send --text "$s" </dev/null >"$out" 2>&1 & p=$!
    until c="$(grep -oE 'croc [a-z]+(-[a-z]+)+' "$out" | head -1 | cut -d' ' -f2)" && [ -n "$c" ]; do
      kill -0 "$p" 2>/dev/null || { cat "$out" >&2; exit 1; }; sleep 0.2
    done
    printf 'share: [1/3] room open at the relay — one-time code ready (room holds ~3h)\n' >&2
    printf '\ntell %s to run:\n\n  share friends accept %s %s\n\n' "$n" "$me" "$c"
    printf 'share: [2/3] waiting for %s to accept... (Ctrl-C to cancel; code is single-use)\n' "$n" >&2
    wait "$p"
    printf 'share: [3/3] secret delivered over PAKE — registering %s\n' "$n" >&2
    "$0" add "$n" "$s";;
  accept)
    n="${2:?usage: share friends accept NAME CODE}"; c="${3:?usage: share friends accept NAME CODE}"
    printf 'share: [1/2] joining %s'\''s room with the one-time code...\n' "$n" >&2
    s="$(CROC_SECRET="$c" croc --yes </dev/null 2>/dev/null)"; [ -n "$s" ] || { echo "share: pairing failed (wrong, used, or expired code? rooms die after ~3h)" >&2; exit 1; }
    printf 'share: [2/2] secret received over PAKE — registering %s\n' "$n" >&2
    "$0" add "$n" "$s";;
  *) env | sed -n 's/^SHARE_SECRET_\([^=]*\)=.*/\1/p' | tr 'A-Z_' 'a-z-';;
esac
