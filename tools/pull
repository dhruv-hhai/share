#!/usr/bin/env bash
# desc: receive from a friend (waits for their push without holding the room open)
# usage: share pull --friend NAME [--dest DIR] [--salt SALT] [--quiet]      (default ~/share/NAME)
# SHARE_PULL_DIR moves the base folder: pulls land in $SHARE_PULL_DIR/NAME.
# Waits politely: a receiver parked at the relay before the push exists can
# poison the room (sender dies with 'could not secure channel'). So each try
# either transfers, or — on 'relay admission rejected' / 'waiting for sender'
# with no data flowing — is torn down and retried 15s later. The code is
# re-derived each try, surviving the UTC-midnight rotation.
set -euo pipefail
f=""; d=""; s=""; quiet=""; while [ $# -gt 0 ]; do case "$1" in --friend|-f) f="${2:?}"; shift 2;; --dest|-d) d="${2:?}"; shift 2;; --salt) s="${2:?}"; shift 2;; --quiet|-q) quiet=1; shift;; *) shift;; esac; done
[ -n "$f" ] || { echo "usage: share pull --friend NAME [--dest DIR]" >&2; exit 1; }
d="${d:-${SHARE_PULL_DIR:-$HOME/share}/$f}"; mkdir -p "$d"; cd "$d"

waited=""
so="$(mktemp)"; se="$(mktemp)"
cleanup() { rm -f "$so" "$se"; [ -z "${pid:-}" ] || kill "$pid" 2>/dev/null || true; }
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Match push's fallback even when this peer can reach the original relay.
# Explicit pins remain on that relay; both peers must use the same pin.
relay="${SHARE_RELAY:-${CROC_RELAY:-}}"; fallback="croc.schollz.com:9009"
switch_after="${SHARE_RELAY_WAIT:-60}"; t0="$(date +%s)"

while :; do
  CROC_SECRET="$(code -f "$f" ${s:+--salt "$s"})"; export CROC_SECRET
  left=$(( 86400 - $(date -u +%s) % 86400 ))
  [ -n "$waited$quiet" ] || printf 'share: [1/2] code for %s today: %s  (rotates at UTC midnight — in %dh%02dm)\n' "$f" "$CROC_SECRET" $((left/3600)) $(((left%3600)/60)) >&2
  [ -n "$waited$quiet" ] || printf 'share: [2/2] joining their push — waiting until one is live (each push serves ONE pull)\n' >&2

  : > "$so"; : > "$se"
  # stdout carries croc fatal errors; stderr carries progress — shown live AND watched
  args=(--yes --overwrite); [ -z "$relay" ] || args+=(--relay "$relay")
  exec 3> >(tee "$se" >&2); tee_pid=$!
  croc "${args[@]}" > "$so" 2>&3 & pid=$!

  idle=""
  while kill -0 "$pid" 2>/dev/null; do
    if [ -z "$relay" ] && [ $(( $(date +%s) - t0 )) -ge "$switch_after" ] && ! grep -qE 'Receiving|%' "$se" 2>/dev/null; then
      kill "$pid" 2>/dev/null || true; wait "$pid" 2>/dev/null || true
      relay="$fallback"; idle=1; break
    fi
    if grep -q 'waiting for sender' "$se" 2>/dev/null; then
      # admitted but no sender — grace period, then tear down rather than hold the room
      sleep 3
      if kill -0 "$pid" 2>/dev/null && ! grep -qE 'Receiving|%' "$se" 2>/dev/null; then
        kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null || true; idle=1
      fi
      break
    fi
    sleep 0.3
  done
  exec 3>&-; wait "$tee_pid" || true
  if [ -z "$idle" ]; then
    if wait "$pid"; then pid=""; [ -s "$so" ] && cat "$so"; exit 0; fi
    pid=""
    if [ -z "$relay" ] && grep -qE 'could not connect to .*: i/o timeout' "$so" "$se"; then
      relay="$fallback"; printf 'share: relay unavailable; retrying via %s\n' "$relay" >&2
      continue
    fi
    grep -q 'relay admission rejected' "$so" || { [ -s "$so" ] && cat "$so" >&2; exit 1; }
  fi
  pid=""
  [ -n "$waited$quiet" ] || printf '\nshare: no push from %s yet — retrying every 15s without holding the room (Ctrl-C stops; they run: share push --friend %s PATH)\n' "$f" "$(whoami)" >&2
  waited=1; sleep 15
done
