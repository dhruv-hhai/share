#!/usr/bin/env bash
# desc: continuous two-way folder sync with a friend — git-merged, nothing lost
# usage: share sync --friend NAME --role a|b [--dir DIR] [--every SEC] [--fg]
#        share sync --friend NAME          restart from the saved config (role/dir remembered per friend)
#        share sync status                 every sync daemon: friend, role, health verdict, pid, dir
#        share sync check [--friend NAME] [--repair]   health with an exit code (0 = fine); --repair restarts the sick
#        share sync restart --friend NAME  stop + start from the saved config
#        share sync stop --friend NAME     stop one (kills the whole process tree)
#        share sync log --friend NAME      where the log is + last lines
#        share sync history --friend NAME [N]   last N file changes (default 20): who, when, A/M/D per file
# Runs in the background by default (its own process group; log in $TMPDIR).
# Needs the git BINARY only — no account, no remote, no network git: each side
# keeps a local repo inside the folder and what travels (over the same croc
# relay, in two direction-scoped rooms via code --salt) is a git bundle file.
# Role a pushes on sync-a2b and pulls sync-b2a; role b the opposite — agree
# roles once, out of band.
# Semantics: edits are committed locally, bundles are merged on arrival.
# Deletes propagate. Concurrent edits to one text file (*.md/*.txt) merge as
# append-both (union); other conflicting files keep YOURS in place and save
# THEIRS beside it as NAME.conflict-<timestamp> — no byte is ever dropped.
# A stale queued push can no longer eat a local edit: merging, not overwriting.
# Health: every wait is bounded and visible. `status`/`check` verdicts:
#   ok            loops alive, nothing queued
#   waiting-peer  a push is open at the relay, waiting for them to come online
#   stuck         heartbeat stopped, lock stale, or a push older than the cap — restart it
#   down          configured (or was running) but no daemon — `check --repair` restarts it
# The daemon's watchdog resets what it can on its own: respawns a dead loop,
# reopens a push older than SHARE_PUSH_MAX seconds (default 7200) or from
# before the UTC-midnight code rotation, reconnects after a sleep/wake clock
# jump, breaks a lock held >10 min, commits local edits on its own tick (so a
# blocked push never holds your edits hostage). Cron:  */5 * * * * share sync check --repair
# Protocol: the payload is a single file named share-sync-v1.bundle — anything
# else arriving in the sync room is an incompatible peer and is refused LOUDLY
# (both sides must run the same major version; payload changes bump the major).
# CAVEATS: union merge is line-based — simultaneous edits to the same line
# arrive as both lines, adjacent; history grows in .git (squash if you care).
set -euo pipefail
tmp="${TMPDIR:-/tmp}"
cfgd="${XDG_CONFIG_HOME:-$HOME/.config}/share/sync"   # one file per friend: "ROLE EVERY DIR" — survives reboot + $TMPDIR purge
pmax="${SHARE_PUSH_MAX:-7200}"                        # reopen a push waiting longer than this (relay drops unclaimed rooms ~3h)

# Daemons found by process scan, one line per daemon: "PGID FRIEND ROLE". The pid
# file is the primary record, but macOS purges $TMPDIR files untouched for ~3 days
# (the daemon touches its own, but older ones lost theirs) — this is the fallback.
# pgid = the setsid leader = the pid the file would hold; sort -u folds the loop subshells.
daemons_ps() { ps -axo pgid=,command= | sed -n 's/^ *\([0-9][0-9]*\) .*tools\/sync --fg --friend \([^ ]*\) --role \([ab]\).*$/\1 \2 \3/p' | sort -u; }
mtime()      { stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null || echo 0; }
ago()        { if [ "$1" -ge 3600 ]; then printf '%dh%02dm' $(($1/3600)) $(($1%3600/60)); elif [ "$1" -ge 60 ]; then printf '%dm' $(($1/60)); else printf '%ds' "$1"; fi; }
older()      { [ -e "$1" ] && [ -n "$(find "$1" -maxdepth 0 -mmin +"$2" 2>/dev/null)" ]; }   # path, minutes
# Every friend we know of: pid files, live processes, saved configs.
friends_known() { { for p in "$tmp"/share-sync-*.pid; do [ -f "$p" ] && { p="$(basename "$p" .pid)"; echo "${p#share-sync-}"; }; done
                    daemons_ps | awk '{print $2}'
                    for c in "$cfgd"/*; do [ -f "$c" ] && basename "$c"; done; } 2>/dev/null | sort -u; }
# info F -> pid (empty if not running), role, dir — from the pid file, falling back to ps and the saved config.
info() { pid=""; role=""; dir=""; local pf="$tmp/share-sync-$1.pid"
  [ ! -f "$pf" ] || read -r pid role dir _ < "$pf"
  { [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; } || pid="$(daemons_ps | awk -v f="$1" '$2==f{print $1; exit}')"
  [ -n "$role" ] || { [ ! -f "$cfgd/$1" ] || read -r role _ dir < "$cfgd/$1"; }; }
# health F -> "VERDICT<TAB>DETAIL<TAB>ROLE<TAB>DIR" (see header for the verdicts).
health() { local f="$1" v="" d now age pf; now="$(date +%s)"; info "$f"; pf="$tmp/share-sync-$f.pid"
  if [ -z "$pid" ]; then v=down; d="not running"
  else
    d="pid $pid"
    if [ -f "$pf" ] && older "$pf" 2; then v=stuck; d="$d, heartbeat $(ago $((now - $(mtime "$pf")))) old"; fi
    if older "$tmp/share-sync-$f.gitlock" 10; then v=stuck; d="$d, lock stale $(ago $((now - $(mtime "$tmp/share-sync-$f.gitlock"))))"; fi
    if [ -f "$tmp/share-sync-$f.push" ]; then
      read -r age _ < "$tmp/share-sync-$f.push"; age=$((now - age)); d="$d, push waiting $(ago "$age")"
      if [ "$age" -gt $((pmax + 300)) ]; then v=stuck; else v="${v:-waiting-peer}"; fi
    fi
    v="${v:-ok}"
  fi
  if [ -d "$dir/.git" ]; then local unsent dirty
    unsent="$(git -C "$dir" rev-list --count refs/share/sent..HEAD 2>/dev/null || git -C "$dir" rev-list --count HEAD 2>/dev/null || echo 0)"
    dirty="$(git -C "$dir" status --porcelain 2>/dev/null | wc -l | tr -d ' ')"
    [ "$unsent" = 0 ] || d="$d, unsent $unsent"; [ "$dirty" = 0 ] || d="$d, dirty $dirty"
  fi
  [ ! -f "$tmp/share-sync-$f.log" ] || d="$d, last event $(ago $((now - $(mtime "$tmp/share-sync-$f.log")))) ago"
  printf "%s\t%s\t%s\t%s\n" "$v" "$d" "${role:-?}" "${dir:-?}"; }
stop_friend() { local f="$1"; local p="" pf="$tmp/share-sync-$f.pid"
  [ ! -f "$pf" ] || read -r p _ < "$pf"
  [ -n "$p" ] || p="$(daemons_ps | awk -v f="$f" '$2==f{print $1; exit}')"
  [ -n "$p" ] || { echo "share sync: nothing running for $f" >&2; return 1; }
  kill -TERM -- "-$p" 2>/dev/null || kill -TERM "$p" 2>/dev/null || true
  rm -f "$pf" "$tmp/share-sync-$f.push" "$tmp/share-sync-$f.reset" 2>/dev/null; rmdir "$tmp/share-sync-$f.gitlock" 2>/dev/null || true
  echo "share sync: stopped $f (pid $p and its tree)"; }
# remember F: a daemon started before configs existed (or whose config was lost) — learn role/dir from its pid file
remember()    { [ -f "$cfgd/$1" ] && return 0; info "$1"; { [ -n "$role" ] && [ -n "$dir" ]; } || return 1; mkdir -p "$cfgd"; printf '%s %s %s\n' "$role" 15 "$dir" > "$cfgd/$1"; }
start_saved() { [ -f "$cfgd/$1" ] || { echo "share sync: no saved config for $1 — start it once with --role (and --dir)" >&2; return 1; }; "$0" --friend "$1"; }
friend_arg() { f=""; while [ $# -gt 0 ]; do case "$1" in --friend|-f) f="${2:?}"; shift 2;; *) shift;; esac; done; [ -n "$f" ] || { echo "usage: share sync $sub --friend NAME" >&2; exit 1; }; }

sub="${1:-}"
case "$sub" in
  status)
    found=""
    while read -r f; do [ -n "$f" ] || continue; found=1
      h="$(health "$f")"; IFS=$'\t' read -r v d r dd <<< "$h"; printf '%-12s role %s  %-13s %s  %s\n' "$f" "$r" "$v" "$d" "$dd"
    done < <(friends_known)
    [ -n "$found" ] || echo "no sync daemons"
    exit 0;;
  check)
    shift; f=""; repair=""; while [ $# -gt 0 ]; do case "$1" in --friend|-f) f="${2:?}"; shift 2;; --repair) repair=1; shift;; *) shift;; esac; done
    bad=0
    while read -r n; do [ -n "$n" ] || continue
      h="$(health "$n")"; IFS=$'\t' read -r v d _ _ <<< "$h"; printf '%-12s %-13s %s\n' "$n" "$v" "$d"
      case "$v" in ok|waiting-peer) continue;; esac
      if [ -n "$repair" ]; then
        remember "$n" || true; [ "$v" = down ] || stop_friend "$n" || true
        if start_saved "$n"; then echo "share sync: repaired $n"; else bad=1; fi
      else bad=1; fi
    done < <(if [ -n "$f" ]; then echo "$f"; else friends_known; fi)
    exit "$bad";;
  restart)
    shift; friend_arg "$@"; remember "$f" || true; stop_friend "$f" || true; sleep 0.5; exec "$0" --friend "$f";;
  stop)
    shift; friend_arg "$@"; stop_friend "$f"; exit $?;;
  log)
    shift; friend_arg "$@"
    lg="$tmp/share-sync-$f.log"
    [ -f "$lg" ] || { echo "share sync: no log for $f" >&2; exit 1; }
    echo "$lg"; tail -20 "$lg"
    exit 0;;
  history)
    shift; f=""; n=20; while [ $# -gt 0 ]; do case "$1" in --friend|-f) f="${2:?}"; shift 2;; [0-9]*) n="$1"; shift;; *) shift;; esac; done
    [ -n "$f" ] || { echo "usage: share sync history --friend NAME [N]" >&2; exit 1; }
    info "$f"; hd="${dir:-${SHARE_PULL_DIR:-$HOME/share}/$f}"
    [ -d "$hd/.git" ] || { echo "share sync: no sync history at $hd" >&2; exit 1; }
    # mine = commits made here; theirs arrive inside merge commits — --first-parent keeps the local timeline
    git -C "$hd" log -"$n" --date=format:'%m-%d %H:%M' --pretty='%ad  %s' --name-status | sed '/^$/d'
    exit 0;;
esac

f=""; role=""; d=""; every=""; fg=""
while [ $# -gt 0 ]; do case "$1" in
  --friend|-f) f="${2:?}"; shift 2;;
  --role|-r)   role="${2:?}"; shift 2;;
  --dir)       d="${2:?}"; shift 2;;
  --every)     every="${2:?}"; shift 2;;
  --fg)        fg=1; shift;;
  *) shift;;
esac; done
[ -n "$f" ] || { echo "usage: share sync --friend NAME --role a|b [--dir DIR] [--every SEC] [--fg]" >&2; exit 1; }
# no --role: resume from the saved config (what `restart` and `check --repair` use)
if [ -z "$role" ] && [ -f "$cfgd/$f" ]; then read -r srole severy sdir < "$cfgd/$f"; role="$srole"; d="${d:-$sdir}"; every="${every:-$severy}"; fi
{ [ "$role" = a ] || [ "$role" = b ]; } || { echo "usage: share sync --friend NAME --role a|b [--dir DIR] [--every SEC] [--fg]   (no saved config for $f yet)" >&2; exit 1; }
every="${every:-15}"
command -v git >/dev/null || { echo "share sync: needs the git binary (no account or remote — local repo only). macOS: xcode-select --install" >&2; exit 1; }
code -f "$f" >/dev/null   # fail on unknown friend BEFORE daemonizing
d="${d:-${SHARE_PULL_DIR:-$HOME/share}/$f}"; mkdir -p "$d"
pidf="$tmp/share-sync-$f.pid"; lg="$tmp/share-sync-$f.log"
mkdir -p "$cfgd"; printf '%s %s %s\n' "$role" "$every" "$d" > "$cfgd/$f"

if [ -z "$fg" ]; then
  info "$f"; opid="$pid"
  if [ -n "$opid" ]; then
    echo "share sync: already running for $f (pid $opid) — stop it first:  share sync stop --friend $f" >&2; exit 1
  fi
  # own process group (setsid) so stop can kill the whole tree: loops, push/pull, croc
  if command -v perl >/dev/null; then sid=(perl -MPOSIX -e 'setsid; exec @ARGV' --)
  elif command -v python3 >/dev/null; then sid=(python3 -c 'import os,sys; os.setsid(); os.execvp(sys.argv[1], sys.argv[1:])')
  else echo "share sync: no perl/python3 to daemonize — run with --fg yourself" >&2; exit 1; fi
  nohup "${sid[@]}" "$0" --fg --friend "$f" --role "$role" --dir "$d" --every "$every" >> "$lg" 2>&1 &
  pid=$!
  printf '%s %s %s %s\n' "$pid" "$role" "$d" "$lg" > "$pidf"
  echo "share sync: $f (role $role) syncing $d in the background (pid $pid)"
  echo "share sync:   log:    share sync log --friend $f"
  echo "share sync:   health: share sync check --friend $f      stop: share sync stop --friend $f"
  exit 0
fi

# --- git-backed engine (foreground) ---
if [ "$role" = a ]; then out="sync-a2b"; in_="sync-b2a"; else out="sync-b2a"; in_="sync-a2b"; fi
printf '%s %s %s %s\n' "$$" "$role" "$d" "$lg" > "$pidf"
stage="$tmp/share-sync-$f-in"; mkdir -p "$stage"
lk="$tmp/share-sync-$f.gitlock"   # mkdir-lock serializes the loops on one repo
pushf="$tmp/share-sync-$f.push"   # "EPOCH HEAD UTCDAY" while a push is open at the relay — what status/watchdog read
resetf="$tmp/share-sync-$f.reset" # watchdog leaves its reason here when it kills a push; the pusher reports it
rmdir "$lk" 2>/dev/null || true; rm -f "$pushf" "$resetf"   # a fresh daemon owns the repo — leftovers of a dead one must not block it

log()    { printf 'share sync: %s  %s\n' "$(date +%H:%M:%S)" "$*" >&2; }
G()      { git -C "$d" "$@"; }
# A lock held >10 min is a corpse (a loop killed mid-critical-section) — break it rather than hang every loop forever.
lock()   { until mkdir "$lk" 2>/dev/null; do ! older "$lk" 10 || { rmdir "$lk" 2>/dev/null && log "broke a stale lock (held >10m)"; }; sleep 0.2; done; }
unlock() { rmdir "$lk" 2>/dev/null || true; }
kill_tree() { local c; for c in $(pgrep -P "$1" 2>/dev/null); do kill_tree "$c"; done; kill "$1" 2>/dev/null || true; }
kill_children() { local c; for c in $(pgrep -P "$1" 2>/dev/null); do kill_tree "$c"; done; }   # a loop's push/pull/croc/sleep — never the loop itself

if [ ! -d "$d/.git" ]; then
  git init -q "$d"
  [ -f "$d/.gitattributes" ] || printf '*.md merge=union\n*.txt merge=union\n' > "$d/.gitattributes"
fi
# local identity so commits work with zero git setup — never touches global config
G config user.email >/dev/null 2>&1 || { G config user.name "share-sync"; G config user.email "sync@share.local"; }

# `git add` can lose the race with an editor mid-write ("short read while indexing") —
# retry, then skip this tick. Never fatal: one bad tick must not take a loop down.
commit_dirty() {
  local i; for i in 1 2 3; do
    G add -A >/dev/null 2>&1 && break
    [ "$i" = 3 ] && { log "git add failed (file mid-write?) — skipping this tick"; return 0; }; sleep 1
  done
  G diff --cached --quiet 2>/dev/null || G commit -qm "sync: $(date -u +%FT%TZ) $(hostname -s)" >/dev/null 2>&1 || log "git commit failed — will retry next tick"
}

# The loops run with errexit OFF: a failing git call must log and move on, not exit
# the subshell holding the lock (which deadlocked the other loop forever).
pusher() {
  set +e
  bd="$tmp/share-sync-$f-out"; mkdir -p "$bd"; bf="$bd/share-sync-v1.bundle"   # payload name IS the protocol version
  while :; do
    lock; commit_dirty
    head="$(G rev-parse -q --verify HEAD 2>/dev/null || true)"
    sent="$(G rev-parse -q --verify refs/share/sent 2>/dev/null || true)"
    if [ -n "$head" ] && [ "$head" != "$sent" ]; then
      G bundle create "$bf" HEAD >/dev/null 2>&1; unlock
      printf '%s %s %s\n' "$(date +%s)" "$head" "$(date -u +%F)" > "$pushf"
      # blocks until they pull — that block is the delivery ack (the watchdog bounds it: see pmax).
      # Backgrounded + wait so a watchdog kill is a plain exit status, not a "Terminated" line in the log.
      push --friend "$f" --salt "$out" "$bf" >/dev/null 2>&1 &
      if wait "$!"; then
        rm -f "$pushf"; lock; G update-ref refs/share/sent "$head"; unlock; log "pushed ${head:0:7}"
      elif [ -f "$resetf" ]; then rm -f "$pushf"; log "push reopened — $(cat "$resetf")"; rm -f "$resetf"
      else rm -f "$pushf"; log "push failed — retrying in ${every}s"; sleep "$every"; fi
    else unlock; sleep "$every"; fi
  done
}

puller() {
  set +e
  pfail=""
  while :; do
    rm -rf "$stage"; mkdir -p "$stage"
    pull --friend "$f" --salt "$in_" --dest "$stage" --quiet >/dev/null 2>&1 &
    if wait "$!"; then
      [ -z "$pfail" ] || { log "pull recovered"; pfail=""; }
      bundle="$stage/share-sync-v1.bundle"
      if [ ! -f "$bundle" ]; then
        log "INCOMPATIBLE PEER — $f sent $(ls "$stage" | head -3 | paste -sd, -) instead of share-sync-v1.bundle; both sides must run the same major version: brew upgrade share"
        sleep "$every"; continue
      fi
      lock; commit_dirty
      if ! G fetch -q "$bundle" HEAD 2>/dev/null; then log "bad bundle — skipped"; unlock; continue; fi
      if ! G rev-parse -q --verify HEAD >/dev/null 2>&1; then
        G reset -q --hard FETCH_HEAD; log "adopted their history"
      elif G merge -q -m "sync: received from $f" --allow-unrelated-histories FETCH_HEAD >/dev/null 2>&1; then
        log "merged theirs: $(G diff --name-only 'HEAD@{1}' HEAD 2>/dev/null | paste -sd, - | cut -c1-120)"
      else
        # union handled text conflicts; leftovers keep OURS, save THEIRS beside — nothing dropped
        while IFS= read -r p; do
          [ -n "$p" ] || continue
          G show ":3:$p" > "$d/$p.conflict-$(date +%F-%H%M%S)" 2>/dev/null || true
          G checkout --ours -- "$p" 2>/dev/null || true
        done < <(G diff --name-only --diff-filter=U)
        G add -A; G commit -qm "sync: conflict — kept ours, saved theirs as .conflict-*"
        log "merged with conflict copies"
      fi
      unlock
    else
      # pull fails hard only when croc itself fails (relay unreachable, bad binary) — say so once, not every tick
      [ -n "$pfail" ] || { log "pull failed — retrying every ${every}s, quietly (relay unreachable? peer mid-restart?)"; pfail=1; }
      sleep "$every"
    fi
  done
}

# Watchdog (runs in the supervisor, every 5s): what `check` would restart the daemon for, fixed in place.
#   - a push open longer than pmax, or opened before the UTC-midnight code rotation, is killed → pusher reopens it
#   - a clock jump (laptop slept) → kill in-flight push/pull so croc reconnects instead of trusting a dead socket
#   - the pid-file touch is the heartbeat `status` reads; the commit tick keeps edits flowing while a push blocks
reset_push() { [ -f "$pushf" ] || return 0; echo "$1" > "$resetf"; kill_children "$pp"; }
watch() {
  local now pt pday age
  now="$(date +%s)"
  if [ $((now - last)) -gt 90 ]; then log "clock jumped $(ago $((now - last))) (sleep/wake?) — reconnecting"; reset_push "clock jumped (sleep/wake)"; kill_children "$lp"; fi
  last="$now"
  if [ -f "$pushf" ] && read -r pt _ pday < "$pushf"; then
    age=$((now - pt))
    if [ "$age" -gt "$pmax" ]; then reset_push "waited $(ago "$age") > cap $(ago "$pmax") (relay drops unclaimed rooms ~3h)"
    elif [ "$pday" != "$(date -u +%F)" ]; then reset_push "code rotated at UTC midnight while waiting $(ago "$age")"; fi
  fi
  if [ $((now - lastc)) -ge "$every" ]; then lock; commit_dirty; unlock; lastc="$now"; fi
  touch "$pidf" 2>/dev/null || true
}

log "$d <-> $f (role $role, every ${every}s, git-merged, push cap $(ago "$pmax"))"
pusher & pp=$!
puller & lp=$!
trap 'kill "$pp" "$lp" 2>/dev/null; unlock; exit 0' INT TERM
set +e   # the supervisor must outlive any failing check
last="$(date +%s)"; lastc="$last"
while :; do
  kill -0 "$pp" 2>/dev/null || { log "push loop died — respawning"; pusher & pp=$!; }
  kill -0 "$lp" 2>/dev/null || { log "pull loop died — respawning"; puller & lp=$!; }
  watch; sleep 5
done
