#!/usr/bin/env bash
# shellcheck disable=SC2154
# desc: continuous two-way folder sync with a friend — causal file registers and deterministic conflicts
# usage: share sync --friend NAME --role a|b [--dir DIR] [--every SEC] [--fg]
#        share sync --friend NAME          restart from the saved config (role/dir remembered per friend)
#        share sync status                 every sync daemon: friend, role, health verdict, pid, dir
#        share sync check [--friend NAME] [--repair]   health with an exit code (0 = fine); --repair restarts the sick
#        share sync restart --friend NAME  stop + start from the saved config
#        share sync stop --friend NAME     stop one (kills the whole process tree)
#        share sync log --friend NAME      where the log is + last lines
#        share sync history --friend NAME [N]   last N file changes (default 20): who, when, A/M/D per file
# Runs in the background by default (its own process group; log in $TMPDIR).
# State-based file registers in .share/: portable version vectors and content
# hashes, no git engine. Role a sends on sync-a2b, role b on sync-b2a.
# Concurrent edits keep a deterministic winner and content-named conflict
# copies; an elected replica may merge nonoverlapping text edits with diff3.
# Causal siblings are retained until a normal edit supersedes them.
# Health: every wait is bounded and visible. `status`/`check` verdicts:
#   ok            loops alive, nothing queued
#   waiting-peer  a push is open at the relay, waiting for them to come online
#   sending       they connected; a push is transferring and croc shows progress
#   stuck         heartbeat stopped, lock stale, a waiting push older than the cap,
#                 or a transfer with no progress — restart it
#   down          configured (or was running) but no daemon — `check --repair` restarts it
# The daemon's watchdog resets what it can on its own: respawns a dead loop,
# reopens a push still WAITING after SHARE_PUSH_MAX seconds (default 7200) or
# from before the UTC-midnight code rotation, reopens a TRANSFER only when croc
# shows no progress for SHARE_PUSH_STALL seconds (default 900) — never merely
# for taking long, so big folders on slow links finish — reconnects after a sleep/wake clock
# jump, breaks a lock held >10 min, versions local edits on its own tick (so a
# blocked push never holds your edits hostage). Cron:  */5 * * * * share sync check --repair
# Protocol: share-sync-v2.tar contains version, replica, manifest, blobs/base.
# Unknown payload names are refused: upgrade both sides together.
# Missing blobs are retried; peer manifests are only bandwidth hints.
# State stores current content and bounded text bases, not historical binaries.
# File IO and the pure merge live in ../lib; transport/watchdog stay here.
set -euo pipefail
# state is initialized by init_state in lib/sync-files.sh.
# shellcheck disable=SC2154
export LC_ALL=C
sync_lib="$(cd "$(dirname "$0")/../lib" && pwd)"
# shellcheck source=../lib/sync-state.sh
. "$sync_lib/sync-state.sh"
# shellcheck source=../lib/sync-files.sh
. "$sync_lib/sync-files.sh"
# shellcheck source=../lib/sync-payload.sh
. "$sync_lib/sync-payload.sh"
tmp="${TMPDIR:-/tmp}"
cfgd="${XDG_CONFIG_HOME:-$HOME/.config}/share/sync"   # one file per friend: "ROLE EVERY DIR" — survives reboot + $TMPDIR purge
pmax="${SHARE_PUSH_MAX:-7200}"                        # reopen a push waiting longer than this (relay drops unclaimed rooms ~3h)
pstall="${SHARE_PUSH_STALL:-900}"                     # once bytes flow, reopen only if croc shows no progress for this long

# Daemons found by process scan, one line per daemon: "PGID FRIEND ROLE". The pid
# file is the primary record, but macOS purges $TMPDIR files untouched for ~3 days
# (the daemon touches its own, but older ones lost theirs) — this is the fallback.
# pgid = the background job leader = the pid the file would hold; sort -u folds the loop subshells.
daemons_ps() { ps -axo pgid=,command= | sed -n 's/^ *\([0-9][0-9]*\) .*tools\/sync --fg --friend \([^ ]*\) --role \([ab]\).*$/\1 \2 \3/p' | sort -u; }
# GNU first: GNU `stat -f` means --file-system and prints a block of text before failing, which the BSD-first order
# captured as the "mtime" on Linux. BSD `stat -c` fails cleanly with nothing on stdout.
mtime()      { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || echo 0; }
ago()        { if [ "$1" -ge 3600 ]; then printf '%dh%02dm' $(($1/3600)) $(($1%3600/60)); elif [ "$1" -ge 60 ]; then printf '%dm' $(($1/60)); else printf '%ds' "$1"; fi; }
older()      { [ -e "$1" ] && [ -n "$(find "$1" -maxdepth 0 -mmin +"$2" 2>/dev/null)" ]; }   # path, minutes
# A push has two phases: waiting at the relay for the peer, then transferring. The room caps (SHARE_PUSH_MAX, UTC
# rotation) only make sense while waiting — a transfer in flight already has its connection, and killing it threw
# away every byte sent (a big bundle on a slow link restarted from zero forever). croc's sender prints "Sending ("
# the moment the peer connects, then a progress bar that rewrites the log as bytes move: started = that line is
# there, progress age = how long since the log last changed.
sending()    { grep -qF 'Sending (' "$tmp/share-sync-$1.pushlog" 2>/dev/null; }
quiet_for()  { echo $(( $(date +%s) - $(mtime "$tmp/share-sync-$1.pushlog") )); }
# Every friend we know of: pid files, live processes, saved configs.
friends_known() { { for p in "$tmp"/share-sync-*.pid; do [ -f "$p" ] && { p="$(basename "$p" .pid)"; echo "${p#share-sync-}"; }; done
                    daemons_ps | awk '{print $2}'
                    for c in "$cfgd"/*; do [ -f "$c" ] && basename "$c"; done; } 2>/dev/null | sort -u; }
# info F -> pid (empty if not running), role, dir — from the pid file, falling back to ps and the saved config.
info() { pid=""; role=""; dir=""; local pf="$tmp/share-sync-$1.pid"
  [ ! -f "$pf" ] || read -r pid role dir _ < "$pf" || pid=""
  { [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; } || pid="$(daemons_ps | awk -v f="$1" '$2==f{print $1; exit}')"
  [ -n "$role" ] || { [ ! -f "$cfgd/$1" ] || read -r role _ dir < "$cfgd/$1"; }; }
# health F -> "VERDICT<TAB>DETAIL<TAB>ROLE<TAB>DIR" (see header for the verdicts).
health() { local f="$1" v="" d now age pf; now="$(date +%s)"; info "$f"; pf="$tmp/share-sync-$f.pid"
  if [ -z "$pid" ]; then v=down; d="not running"
  else
    d="pid $pid"
    if [ -f "$pf" ] && older "$pf" 2; then v=stuck; d="$d, heartbeat $(ago $((now - $(mtime "$pf")))) old"; fi
    if older "$tmp/share-sync-$f.gitlock" 10; then v=stuck; d="$d, lock stale $(ago $((now - $(mtime "$tmp/share-sync-$f.gitlock"))))"; fi
    if [ -f "$tmp/share-sync-$f.push" ]; then
      read -r age _ < "$tmp/share-sync-$f.push"; age=$((now - age))
      if sending "$f"; then local q; q="$(quiet_for "$f")"
        d="$d, push sending for $(ago "$age") (progress $(ago "$q") ago)"
        if [ "$q" -gt $((pstall + 300)) ]; then v=stuck; else v="${v:-sending}"; fi
      else
        d="$d, push waiting $(ago "$age")"
        if [ "$age" -gt $((pmax + 300)) ]; then v=stuck; else v="${v:-waiting-peer}"; fi
      fi
    fi
    v="${v:-ok}"
  fi
  if [ -f "$dir/.share/manifest" ]; then local pending siblings tombstones
    if [ -f "$dir/.share/peer/$f.pushed" ]; then
      pending="$(awk 'FILENAME==ARGV[1]{seen[$0]=1;next}!($0 in seen){n++}END{print n+0}' "$dir/.share/peer/$f.pushed" "$dir/.share/manifest")"
    else pending="$(wc -l < "$dir/.share/manifest" | tr -d ' ')"; fi
    siblings="$(cut -f1 "$dir/.share/manifest" | sort | uniq -d | wc -l | tr -d ' ')"
    tombstones="$(awk -F '\t' '$2=="-"{n++}END{print n+0}' "$dir/.share/manifest")"
    d="$d, pending $pending, siblings $siblings, tombstones $tombstones"
    local dpct dfree; read -r dpct dfree < <(df -Pk "$dir" 2>/dev/null | awk 'NR==2{sub("%","",$5); print $5, int($4/1024)}')
    # loud only on free space (what the fence uses): APFS reports purgeable space as used, so a percentage alone misleads
    if [ "${dfree:-999999}" -lt "${SHARE_DISK_RESERVE_MB:-1024}" ]; then d="$d, DISK LOW ${dfree}MB free (${dpct}% used)"
    elif [ "${dpct:-0}" -ge 80 ]; then d="$d, disk ${dpct}% used ${dfree}MB free"; fi
  fi
  [ ! -f "$tmp/share-sync-$f.log" ] || d="$d, last event $(ago $((now - $(mtime "$tmp/share-sync-$f.log")))) ago"
  printf "%s\t%s\t%s\t%s\n" "$v" "$d" "${role:-?}" "${dir:-?}"; }
stop_friend() { local f="$1"; local p="" pf="$tmp/share-sync-$f.pid"
  [ ! -f "$pf" ] || read -r p _ < "$pf" || p=""
  [ -n "$p" ] || p="$(daemons_ps | awk -v f="$f" '$2==f{print $1; exit}')"
  [ -n "$p" ] || { echo "share sync: nothing running for $f" >&2; return 1; }
  kill -TERM -- "-$p" 2>/dev/null || kill -TERM "$p" 2>/dev/null || true
  rm -f "$pf" "$tmp/share-sync-$f.push" "$tmp/share-sync-$f.pushlog" "$tmp/share-sync-$f.reset" 2>/dev/null; rm -f "$tmp/share-sync-$f.gitlock/pid"; rmdir "$tmp/share-sync-$f.gitlock" 2>/dev/null || true
  echo "share sync: stopped $f (pid $p and its tree)"; }
# remember F: a daemon started before configs existed (or whose config was lost) — learn role/dir from its pid file
remember()    { [ -f "$cfgd/$1" ] && return 0; info "$1"; { [ -n "$role" ] && [ -n "$dir" ]; } || return 1; mkdir -p "$cfgd"; printf '%s %s %s\n' "$role" 15 "$dir" > "$cfgd/$1"; }
start_saved() { [ -f "$cfgd/$1" ] || { echo "share sync: no saved config for $1 — start it once with --role (and --dir)" >&2; return 1; }; "$0" --friend "$1"; }
friend_arg() { f=""; while [ $# -gt 0 ]; do case "$1" in --friend|-f) f="${2:?}"; shift 2;; *) shift;; esac; done; [ -n "$f" ] || { echo "usage: share sync $sub --friend NAME" >&2; exit 1; }; }

sub="${1:-}"
case "$sub" in
  status)
    found=""
    while read -r f; do [ -n "$f" ] || continue; found=1
      h="$(health "$f")"; IFS=$'\t' read -r v d r dd <<< "$h"; printf '%-12s role %s  %-13s %s  %s\n' "$f" "$r" "$v" "$d" "$dd"
    done < <(friends_known)
    [ -n "$found" ] || echo "no sync daemons"
    exit 0;;
  check)
    shift; f=""; repair=""; while [ $# -gt 0 ]; do case "$1" in --friend|-f) f="${2:?}"; shift 2;; --repair) repair=1; shift;; *) shift;; esac; done
    bad=0
    while read -r n; do [ -n "$n" ] || continue
      h="$(health "$n")"; IFS=$'\t' read -r v d _ _ <<< "$h"; printf '%-12s %-13s %s\n' "$n" "$v" "$d"
      case "$v" in ok|waiting-peer|sending) continue;; esac
      if [ -n "$repair" ]; then
        remember "$n" || true; [ "$v" = down ] || stop_friend "$n" || true
        if start_saved "$n"; then echo "share sync: repaired $n"; else bad=1; fi
      else bad=1; fi
    done < <(if [ -n "$f" ]; then echo "$f"; else friends_known; fi)
    exit "$bad";;
  restart)
    shift; friend_arg "$@"; remember "$f" || true; stop_friend "$f" || true; sleep 0.5; exec "$0" --friend "$f";;
  stop)
    shift; friend_arg "$@"; stop_friend "$f"; exit $?;;
  log)
    shift; friend_arg "$@"
    lg="$tmp/share-sync-$f.log"
    [ -f "$lg" ] || { echo "share sync: no log for $f" >&2; exit 1; }
    echo "$lg"; tail -20 "$lg"
    exit 0;;
  history)
    shift; f=""; n=20; while [ $# -gt 0 ]; do case "$1" in --friend|-f) f="${2:?}"; shift 2;; [0-9]*) n="$1"; shift;; *) shift;; esac; done
    [ -n "$f" ] || { echo "usage: share sync history --friend NAME [N]" >&2; exit 1; }
    info "$f"; hd="${dir:-${SHARE_PULL_DIR:-$HOME/share}/$f}"
    [ -f "$hd/.share/history" ] || { echo "share sync: no sync history at $hd" >&2; exit 1; }
    # Writer is the trailing column; lines written before writers existed have four.
    tail -n "$n" "$hd/.share/history" | awk -F '\t' '{t=substr($1,6,11);sub(/T/," ",t);printf "%s  %s  %s %s",t,$2,$3,$4;if($5!="")printf "  %s",$5;print ""}'
    exit 0;;
esac

f=""; role=""; d=""; every=""; fg=""; writer="${SHARE_WRITER:--}"
while [ $# -gt 0 ]; do case "$1" in
  --friend|-f) f="${2:?}"; shift 2;;
  --role|-r)   role="${2:?}"; shift 2;;
  --dir)       d="${2:?}"; shift 2;;
  --every)     every="${2:?}"; shift 2;;
  --writer)    writer="${2:?}"; shift 2;;
  --fg)        fg=1; shift;;
  *) shift;;
esac; done
# Writer names become ledger/queue file names: same charset as .sharemerge strategies.
case "$writer" in ''|*[!A-Za-z0-9_.-]*) echo "share sync: bad --writer name (use A-Za-z0-9_.-)" >&2; exit 1;; esac
[ -n "$f" ] || { echo "usage: share sync --friend NAME --role a|b [--dir DIR] [--every SEC] [--fg]" >&2; exit 1; }
# no --role: resume from the saved config (what `restart` and `check --repair` use)
if [ -z "$role" ] && [ -f "$cfgd/$f" ]; then read -r srole severy sdir < "$cfgd/$f"; role="$srole"; d="${d:-$sdir}"; every="${every:-$severy}"; fi
{ [ "$role" = a ] || [ "$role" = b ]; } || { echo "usage: share sync --friend NAME --role a|b [--dir DIR] [--every SEC] [--fg]   (no saved config for $f yet)" >&2; exit 1; }
every="${every:-15}"
code -f "$f" >/dev/null   # fail on unknown friend BEFORE daemonizing
d="${d:-${SHARE_PULL_DIR:-$HOME/share}/$f}"; mkdir -p "$d"; d="$(cd "$d" && pwd -P)"
pidf="$tmp/share-sync-$f.pid"; lg="$tmp/share-sync-$f.log"
mkdir -p "$cfgd"; printf '%s %s %s\n' "$role" "$every" "$d" > "$cfgd/$f"

if [ -z "$fg" ]; then
  info "$f"; opid="$pid"
  if [ -n "$opid" ]; then
    echo "share sync: already running for $f (pid $opid) — stop it first:  share sync stop --friend $f" >&2; exit 1
  fi
  # Bash job control gives this job its own process group, so stop still kills
  # the whole tree. nohup ignores terminal hangups; redirect stdin as well as
  # output so the daemon never reads from its launching terminal or pipeline.
  set -m
  nohup "$0" --fg --friend "$f" --role "$role" --dir "$d" --every "$every" </dev/null >> "$lg" 2>&1 &
  pid=$!
  set +m
  printf '%s %s %s %s\n' "$pid" "$role" "$d" "$lg" > "$pidf"
  echo "share sync: $f (role $role) syncing $d in the background (pid $pid)"
  echo "share sync:   log:    share sync log --friend $f"
  echo "share sync:   health: share sync check --friend $f      stop: share sync stop --friend $f"
  exit 0
fi

# --- CRDT engine (foreground) ---
if [ "$role" = a ]; then out="sync-a2b"; in_="sync-b2a"; else out="sync-b2a"; in_="sync-a2b"; fi
printf '%s %s %s %s\n' "$$" "$role" "$d" "$lg" > "$pidf"
stage="$tmp/share-sync-$f-in"; mkdir -p "$stage"
lk="$tmp/share-sync-$f.gitlock"   # mkdir-lock serializes the loops on one repo
pushf="$tmp/share-sync-$f.push"   # "EPOCH HEAD UTCDAY" while a push is open at the relay — what status/watchdog read
resetf="$tmp/share-sync-$f.reset" # watchdog leaves its reason here when it kills a push; the pusher reports it
pushlog="$tmp/share-sync-$f.pushlog" # the open push's own output (croc's progress) — what sending()/quiet_for() read
rm -f "$lk/pid"; rmdir "$lk" 2>/dev/null || true; rm -f "$pushf" "$resetf" "$pushlog"   # a fresh daemon owns the repo — leftovers of a dead one must not block it

log()    { printf 'share sync: %s  %s\n' "$(date +%H:%M:%S)" "$*" >&2; }
# A lock held >10 min is a corpse (a loop killed mid-critical-section) — break it rather than hang every loop forever.
# Break a lock only when its holder is gone. Age alone is not staleness: across
# a Mac sleep the holder is suspended, not dead, and breaking its lock let two
# loops prune and merge at once (blobs referenced by the manifest were deleted).
lock()   {
  local owner
  until mkdir "$lk" 2>/dev/null; do
    if older "$lk" 10; then
      owner="$(cat "$lk/pid" 2>/dev/null || true)"
      if [ -z "$owner" ] || ! kill -0 "$owner" 2>/dev/null; then
        rm -f "$lk/pid"; rmdir "$lk" 2>/dev/null && log "broke a stale lock (holder ${owner:-unknown} gone)"
      fi
    fi
    sleep 0.2
  done
  sh -c 'echo "$PPID"' > "$lk/pid"   # this (sub)shell's PID; Bash 3.2 has no BASHPID
}
unlock() { rm -f "$lk/pid"; rmdir "$lk" 2>/dev/null || true; }
# Top-down kill: the parent first (collect its kids before — they reparent to 1 once it dies), then the kids.
# Parent-first matters: croc exits 0 on SIGTERM, and a push whose croc "succeeded" would be taken as delivered.
kill_tree() { local c kids; kids="$(pgrep -P "$1" 2>/dev/null || true)"; kill "$1" 2>/dev/null || true; for c in $kids; do kill_tree "$c"; done; }
# push/pull run under a throwaway `bash -c` wrapper whose stderr is /dev/null: killing the wrapper's subtree (push + croc)
# gives the loop a plain exit status, and bash's "Terminated" report lands in the wrapper, not in the log.
kill_grandkids() { local w c; for w in $(pgrep -P "$1" 2>/dev/null); do for c in $(pgrep -P "$w" 2>/dev/null); do kill_tree "$c"; done; done; }

reserve_mb="${SHARE_DISK_RESERVE_MB:-1024}"
free_kb() { df -Pk "$d" 2>/dev/null | awk 'NR==2{print $4}'; }
init_state
# Keep the existing per-friend lock for this change; never run two friends
# against one folder. A folder lock needs ownership-aware watchdog recovery.
# Errexit is off inside loops: a failed operation must never strand the lock.
pusher() {
  set +e
  bd="$tmp/share-sync-$f-out"; mkdir -p "$bd"; bf="$bd/share-sync-v2.tar"   # payload name IS the protocol version
  while :; do
    lock; scan; retain_blobs
    head="$(hash_file "$state/manifest")"
    sent="$(cat "$state/peer/$f.sent" 2>/dev/null)"
    now="$(date +%s)"; lastpush="$(cat "$state/peer/$f.time" 2>/dev/null || echo 0)"
    if [ "$head" != "$sent" ] || [ $((now-lastpush)) -ge "${SHARE_SYNC_HEARTBEAT:-180}" ]; then
      if [ "$(free_kb)" -lt $((reserve_mb * 1024)) ]; then unlock; log "DISK LOW — reserve ${reserve_mb}MB; retrying"; sleep "$every"; continue; fi
      if ! make_payload; then unlock; log "payload create failed — retrying"; sleep "$every"; continue; fi
      unlock
      t0="$(date +%s)"
      printf '%s %s %s\n' "$t0" "$head" "$(date -u +%F)" > "$pushf"
      # croc prints today's code into this log: owner-only (a world-readable /tmp file would hand it to local users)
      rm -f "$pushlog"; (umask 077; : > "$pushlog")
      # Blocks until they pull; success is only a scheduling hint, not an ack.
      # The watchdog bounds the wait: see pmax; a transfer
      # in flight is bounded by progress instead: see pstall).
      # Wrapper + wait: a watchdog kill is a plain exit status (see kill_grandkids). A reset flag outranks
      # an exit 0 — croc exits 0 when killed, and that must never count as delivered.
      bash -c 'push "$@"; exit $?' _ --friend "$f" --salt "$out" "$bf" >>"$pushlog" 2>&1 &
      if wait "$!" && [ ! -f "$resetf" ]; then
        rm -f "$pushf" "$pushlog"; lock; printf '%s\n' "$head" > "$state/peer/$f.sent"; date +%s > "$state/peer/$f.time"; cp "$bd/snapshot" "$state/peer/$f.pushed"; unlock
        log "pushed ${head:0:7} ($(du -k "$bf" 2>/dev/null | cut -f1)KB) in $(ago $(($(date +%s) - t0)))"
      elif [ -f "$resetf" ]; then rm -f "$pushf" "$pushlog"; log "push reopened — $(cat "$resetf")"; rm -f "$resetf"
      else rm -f "$pushf" "$pushlog"; log "push failed — retrying in ${every}s"; sleep "$every"; fi
    else unlock; sleep "$every"; fi
  done
}

puller() {
  set +e
  pfail=""
  while :; do
    rm -rf "$stage"; mkdir -p "$stage"
    bash -c 'pull "$@"; exit $?' _ --friend "$f" --salt "$in_" --dest "$stage" --quiet >/dev/null 2>&1 &
    if wait "$!"; then
      [ -z "$pfail" ] || { log "pull recovered"; pfail=""; }
      bundle="$stage/share-sync-v2.tar"
      if [ ! -f "$bundle" ]; then
        log "INCOMPATIBLE PEER — $f sent $(ls "$stage" | head -3 | paste -sd, -) instead of share-sync-v2.tar; upgrade both sides together: brew upgrade share"
        sleep "$every"; continue
      fi
      bkb="$(du -k "$bundle" 2>/dev/null | cut -f1)"; fkb="$(free_kb)"
      if [ "${fkb:-0}" -lt $((bkb * 2 + reserve_mb * 1024)) ]; then
        log "DISK LOW — $((fkb / 1024))MB free, bundle $((bkb / 1024))MB needs 2x + ${reserve_mb}MB reserve; skipped (their next push re-covers it) — free space, then: share sync check --repair"
        sleep "$every"; continue
      fi
      lock
      if receive_payload "$bundle"; then log "merged state from $f"
      else log "bad v2 payload — skipped; missing content will be retried"; fi

      unlock
    else
      # pull fails hard only when croc itself fails (relay unreachable, bad binary) — say so once, not every tick
      [ -n "$pfail" ] || { log "pull failed — retrying every ${every}s, quietly (relay unreachable? peer mid-restart?)"; pfail=1; }
      sleep "$every"
    fi
  done
}

# Follow the install: `update --auto` (daily, backgrounded) applies same-major releases; whenever the installed version
# stops matching the one running — auto or manual upgrade, either side — re-exec onto it (same pid, same pid file).
# Resolved from our own install tree, never $PATH (a dev checkout must not follow a brew install, or vice versa):
# brew → the stable opt/share link (cleanup deletes the old Cellar tree under our feet); otherwise the dispatcher beside tools/.
case "$0" in */Cellar/share/*) sharebin="${0%%/Cellar/share/*}/opt/share/libexec/share";; *) sharebin="$(cd "$(dirname "$0")/.." && pwd)/share";; esac
ver="$("$sharebin" update --installed 2>/dev/null || true)"
follow() {
  local iv; iv="$("$sharebin" update --installed 2>/dev/null || true)"
  { [ -n "$iv" ] && [ "$iv" != "$ver" ]; } || return 0
  log "installed share $iv, running $ver — re-exec onto the installed version"
  kill "$pp" "$lp" 2>/dev/null; unlock
  exec "$sharebin" sync --fg --friend "$f" --role "$role" --dir "$d" --every "$every"
}

# Watchdog (runs in the supervisor, every 5s): what `check` would restart the daemon for, fixed in place.
#   - a push still waiting longer than pmax, or opened before the UTC-midnight code rotation, is killed → pusher reopens it
#   - a push already transferring is left alone however long it takes; killed only after pstall seconds with no progress
#   - a clock jump (laptop slept) → kill in-flight push/pull so croc reconnects instead of trusting a dead socket
#   - the pid-file touch is the heartbeat `status` reads; the commit tick keeps edits flowing while a push blocks
reset_push() { [ -f "$pushf" ] || return 0; echo "$1" > "$resetf"; kill_grandkids "$pp"; }
watch() {
  local now pt pday age q
  now="$(date +%s)"
  if [ $((now - last)) -gt 90 ]; then log "clock jumped $(ago $((now - last))) (sleep/wake?) — reconnecting"; reset_push "clock jumped (sleep/wake)"; kill_grandkids "$lp"; fi
  last="$now"
  if [ -f "$pushf" ] && read -r pt _ pday < "$pushf"; then
    age=$((now - pt))
    if sending "$f"; then   # connected and moving bytes: the room caps no longer apply, only a stall does
      q="$(quiet_for "$f")"
      [ "$q" -le "$pstall" ] || reset_push "transfer stalled — no progress for $(ago "$q") > $(ago "$pstall") (after $(ago "$age"))"
    elif [ "$age" -gt "$pmax" ]; then reset_push "waited $(ago "$age") > cap $(ago "$pmax") (relay drops unclaimed rooms ~3h)"
    elif [ "$pday" != "$(date -u +%F)" ]; then reset_push "code rotated at UTC midnight while waiting $(ago "$age")"; fi
  fi
  if [ $((now - lastc)) -ge "$every" ]; then lock; scan; retain_blobs; unlock; lastc="$now"; fi
  if [ $((now - lastu)) -ge 86400 ]; then "$sharebin" update --auto >/dev/null 2>&1 & lastu="$now"; fi
  if [ $((now - lastv)) -ge "${SHARE_FOLLOW_EVERY:-60}" ]; then lastv="$now"; follow; fi
  touch "$pidf" 2>/dev/null || true
}

log "$d <-> $f (role $role, every ${every}s, CRDT, push cap $(ago "$pmax"), share ${ver:-?})"
pusher & pp=$!
puller & lp=$!
trap 'kill "$pp" "$lp" 2>/dev/null; unlock; exit 0' INT TERM
set +e   # the supervisor must outlive any failing check
last="$(date +%s)"; lastc="$last"; lastv="$last"; lastu=0
while :; do
  kill -0 "$pp" 2>/dev/null || { log "push loop died — respawning"; pusher & pp=$!; }
  kill -0 "$lp" 2>/dev/null || { log "pull loop died — respawning"; puller & lp=$!; }
  watch; sleep 5
done
