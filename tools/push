#!/usr/bin/env bash
# desc: send paths to a friend (blocks until they pull; serves ONE pull, then exits)
# usage: share push --friend NAME [--salt SALT] PATH...
set -euo pipefail
f=""; s=""; p=(); while [ $# -gt 0 ]; do case "$1" in --friend|-f) f="${2:?}"; shift 2;; --salt) s="${2:?}"; shift 2;; *) p+=("$1"); shift;; esac; done
[ -n "$f" ] && [ ${#p[@]} -gt 0 ] || { echo "usage: share push --friend NAME PATH..." >&2; exit 1; }
CROC_SECRET="$(code -f "$f" ${s:+--salt "$s"})"; export CROC_SECRET
# two pushes on one code break the room — every pull gets 'relay admission rejected'
lock="${TMPDIR:-/tmp}/share-push-$f${s:+-$s}.pid"
if [ -f "$lock" ] && kill -0 "$(cat "$lock")" 2>/dev/null; then
  echo "share: a push to $f is already live (pid $(cat "$lock")) — two pushes on one code reject every pull. Kill it first:  kill $(cat "$lock")" >&2; exit 1
fi
echo $$ > "$lock"
clog="$(mktemp)"; pid=""
cleanup() { [ -z "$pid" ] || { kill "$pid" 2>/dev/null || true; wait "$pid" 2>/dev/null || true; }; rm -f "$lock" "$clog"; }
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
left=$(( 86400 - $(date -u +%s) % 86400 ))
printf 'share: [1/3] code for %s today: %s  (rotates at UTC midnight — in %dh%02dm)\n' "$f" "$CROC_SECRET" $((left/3600)) $(((left%3600)/60)) >&2
[ "$left" -ge 2700 ] || printf 'share: ⚠ code rotates in %dm — if %s pulls after that, you will miss each other\n' $((left/60)) "$f" >&2
printf 'share: [2/3] opening room at the relay (unclaimed rooms die after ~3h)\n' >&2
printf 'share:       plain croc works too:  croc --yes %s\n' "$CROC_SECRET" >&2
printf 'share: [3/3] waiting for %s to pull — transfer starts the moment they do (one pull per push; rerun to send again)\n' "$f" >&2
# Pins are authoritative (including private relays). Otherwise try croc's normal
# routing first, then the same fixed relay on BOTH peers, even if only one times
# out. A bounded wait before connection lets the reachable peer follow it there.
relay="${SHARE_RELAY:-${CROC_RELAY:-}}"; fallback="croc.schollz.com:9009"
switch_after="${SHARE_RELAY_WAIT:-60}"
while :; do
  t0="$(date +%s)"; switch=""; : > "$clog"
  args=(--yes); [ -z "$relay" ] || args+=(--relay "$relay")
  exec 3> >(tee "$clog" >&2); tee_pid=$!
  croc "${args[@]}" send "${p[@]}" >&3 2>&1 & pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    if [ -z "$relay" ] && [ $(( $(date +%s) - t0 )) -ge "$switch_after" ] && ! grep -qF 'Sending (' "$clog"; then
      switch=1; kill "$pid" 2>/dev/null || true; break
    fi
    sleep 0.3
  done
  if wait "$pid"; then rc=0; else rc=$?; fi; pid=""
  exec 3>&-; wait "$tee_pid" || true
  if [ -z "$relay" ] && { [ -n "$switch" ] || grep -qE 'could not connect to .*: i/o timeout' "$clog"; }; then
    relay="$fallback"; printf 'share: relay unavailable or peer absent; retrying via %s\n' "$relay" >&2
  else exit "$rc"; fi
done
