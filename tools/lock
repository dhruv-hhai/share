#!/usr/bin/env bash
# desc: run a command while holding a named lock on this folder (same host)
# usage: share lock <name> [--ttl 10m] [--wait 60s] [--dir D] [--writer W] -- <cmd>...
#        holds an exclusive flock on .share/locks/<name> while <cmd> runs
#        exit 3: --wait ran out; exit 2: bad arguments; otherwise the command's exit code
#        the kernel releases the lock when the holder exits, even when it is killed;
#        --ttl is the expiry recorded in the ledger and the lock file, not enforced
# flock(1): util-linux on Linux, the flock formula on macOS. Same host only;
# cross-machine exclusion is share lease.
# Each lock and unlock is a ledger entry in .share/ledger/<replica>/<writer>.log.
set -euo pipefail
export LC_ALL=C
die() { echo "share lock: $*" >&2; exit 2; }
log() { echo "share lock: $*" >&2; }
# 30s | 5m | 1h | 45 (plain seconds); 10# keeps "010" decimal
secs() {
  local n u
  n="${1%[smh]}"; u="${1:${#n}}"
  case "$n" in ''|*[!0-9]*) die "bad duration '$1'";; esac
  case "$u" in ''|s) echo $((10#$n));; m) echo $((10#$n*60));; h) echo $((10#$n*3600));; *) die "bad duration '$1'";; esac
}

case "${1:-}" in
  -h|--help) sed -n '3,/^[^#]/{/^#/!q;s/^# \{0,1\}//p;}' "$0"; exit 0;;
  '') die "usage: share lock <name> [--ttl D] [--wait D] [--dir D] [--writer W] -- <cmd>...";;
esac
name="$1"; shift
case "$name" in ''|*[!A-Za-z0-9_.-]*|.*) die "bad lock name '$name'";; esac

ttl_s=600; wait_s=60; dir=""; writer="${SHARE_WRITER:--}"
while [ $# -gt 0 ] && [ "$1" != -- ]; do
  [ $# -ge 2 ] || die "$1 needs a value"
  case "$1" in
    --ttl) ttl_s="$(secs "$2")";;
    --wait) wait_s="$(secs "$2")";;
    --dir) dir="$2";;
    --writer) writer="$2";;
    *) die "unknown option '$1'";;
  esac
  shift 2
done
[ "${1:-}" = -- ] || die "expected -- before the command"
shift
[ $# -gt 0 ] || die "no command after --"
case "$writer" in ''|*[!A-Za-z0-9_.-]*|.*) die "bad writer '$writer'";; esac

if [ -z "$dir" ]; then
  dir="$PWD"
  while [ ! -d "$dir/.share" ]; do [ "$dir" != / ] || die "no .share/ above $PWD (pass --dir)"; dir="$(dirname "$dir")"; done
fi
[ -d "$dir/.share" ] || die "no .share/ in $dir"
state="$dir/.share"
rid="$(cat "$state/replica" 2>/dev/null || true)"
[ -n "$rid" ] || die "no replica id in $state/replica"
command -v flock >/dev/null || die "needs flock(1) (macOS: brew install flock)"
sync_lib="$(cd "$(dirname "$0")/../lib" && pwd)"
# shellcheck source=../lib/sync-ledger.sh
. "$sync_lib/sync-ledger.sh"
lk="$state/locks/$name"; wfull="$rid/$writer"
mkdir -p "$state/locks"

held=0; expires=0
release() {
  [ "$held" = 1 ] || return 0
  held=0
  ledger_append "$wfull" unlock "lock:$name" "$$" "$expires" >/dev/null
  : > "$lk"
}
trap 'rc=$?; release; exit "$rc"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# fd 9 holds the lock for this process's lifetime; never truncate the file
# before acquiring, and never delete it (a waiter could lock a stale inode).
exec 9>> "$lk"
if [ "$wait_s" -eq 0 ]; then flock -n 9 || { log "lock $name is held"; exit 3; }
else flock -w "$wait_s" 9 || { log "gave up after ${wait_s}s waiting for lock $name"; exit 3; }
fi
expires=$(( $(date +%s) + ttl_s ))
printf '%s\t%s\t%s\n' "$$" "$expires" "$wfull" > "$lk"
held=1
ledger_append "$wfull" lock "lock:$name" "$$" "$expires" >/dev/null

# The command must not inherit fd 9, or a daemon it leaves behind would hold the lock.
rc=0
"$@" 9>&- || rc=$?
exit "$rc"
