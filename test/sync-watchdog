#!/usr/bin/env bash
# sync watchdog phases, hermetic: a stub croc (test/stub/croc) plays the peer, so no relay and no network.
# A push WAITING for the peer is bounded by SHARE_PUSH_MAX; a push already TRANSFERRING is bounded only by
# progress (SHARE_PUSH_STALL) — a long transfer must finish, never be cut off and restarted from zero.
# usage: test/sync-watchdog        (~1 min)
set -uo pipefail
repo="$(cd "$(dirname "$0")/.." && pwd)"; share="$repo/share"
export PATH="$repo/test/stub:$PATH" SHARE_SECRET_BOB="watchdog-$$" SHARE_AUTO_UPDATE=0 SHARE_FOLLOW_EVERY=3600
pass() { echo "  ok  $*"; }
fail() { echo "FAIL  $*" >&2; echo "--- log"; cat "$W/t/share-sync-bob.log" 2>/dev/null; exit 1; }
# start MODE [env...]: one daemon (alice's side, friend bob, role a) against the stub in MODE, every 1s
start() { local mode="$1"; shift
  W="$(mktemp -d)"; mkdir -p "$W"/{d,t,cfg}; echo "payload" > "$W/d/hi.md"
  env TMPDIR="$W/t" XDG_CONFIG_HOME="$W/cfg" STUB_MODE="$mode" "$@" "$share" sync --friend bob --role a --dir "$W/d" --every 1 >/dev/null; }
S()    { TMPDIR="$W/t" XDG_CONFIG_HOME="$W/cfg" "$share" sync "$@"; }
stop() { S stop --friend bob >/dev/null 2>&1 || true; rm -rf "$W"; }
logs() { grep -c "$1" "$W/t/share-sync-bob.log" 2>/dev/null || true; }
until_ok() { local n="$1"; shift; for _ in $(seq 1 "$n"); do "$@" 2>/dev/null && return 0; sleep 1; done; return 1; }
trap 'stop' EXIT

echo "sync watchdog (stub croc)"

# Health must report undelivered work even when both loops keep retrying.
start wait
until_ok 10 test -s "$W/d/.share/manifest" || fail "initial manifest"
now="$(date +%s)"
echo "$now" > "$W/d/.share/peer/bob.time"
S check --friend bob >/dev/null || fail "fresh pending push should be healthy"
echo $((now - 901)) > "$W/d/.share/peer/bob.time"
if S check --friend bob > "$W/health"; then fail "stale pending push must exit nonzero"; fi
grep -q 'stuck .*pending delivery overdue' "$W/health" || fail "stale pending push verdict"
pass "pending changes with last push older than 15m are stuck"
cp "$W/d/.share/manifest" "$W/d/.share/peer/bob.pushed"
S check --friend bob >/dev/null || fail "old push without pending changes should be healthy"
pass "old push without pending changes stays healthy"
rm "$W/d/.share/peer/bob.pushed" "$W/d/.share/peer/bob.time"
echo $((now - 901)) > "$W/t/share-sync-bob.started"
if S check --friend bob >/dev/null; then fail "never-delivered changes must become stuck"; fi
pass "first push gets a bounded grace period too"
stop

start pullfail
until_ok 10 test -s "$W/t/share-sync-bob.pullfail" || fail "pull failure marker"
first="$(cat "$W/t/share-sync-bob.pullfail")"
sleep 2
[ "$(cat "$W/t/share-sync-bob.pullfail")" = "$first" ] || fail "retries reset the failure streak"
S check --friend bob | grep -q 'pull failing for' || fail "fresh pull failure detail"
echo $(( $(date +%s) - 901 )) > "$W/t/share-sync-bob.pullfail"
if S check --friend bob > "$W/health"; then fail "old pull failure must exit nonzero"; fi
grep -q 'stuck .*pull failing for 15m' "$W/health" || fail "old pull failure verdict"
pass "pull failure streak is recorded once, visible, and stuck after 15m"
touch "$W/t/pull-recovered"
until_ok 10 test ! -f "$W/t/share-sync-bob.pullfail" || fail "pull recovery clears marker"
S check --friend bob >/dev/null || fail "health recovers after pull success"
pass "successful pull clears failure streak and recovers health"
stop

# Both directions must meet at the fallback when only one cannot connect.
# Exercise the real push/pull wrappers; the stub distinguishes relay arguments.
W="$(mktemp -d)"; mkdir -p "$W"/{d,t,cfg,room}; echo payload > "$W/d/hi.md"
export TMPDIR="$W/t" STUB_MODE=relay STUB_RELAY_LOG="$W/relays" SHARE_RELAY_WAIT=1
unset SHARE_RELAY CROC_RELAY
transport_pair() {
  rm -f "$W/room/push" "$W/room/pull"
  STUB_RELAY_ROOM="$W/room" "$share" push --friend bob "$W/d/hi.md" > "$W/pushlog" 2>&1 & sender=$!
  STUB_RELAY_ROOM="$W/room" "$share" pull --friend bob --dest "$W/d" --quiet > "$W/pulllog" 2>&1 & receiver=$!
  until_ok 25 test -f "$W/room/push" && until_ok 25 test -f "$W/room/pull" || { kill "$sender" "$receiver" 2>/dev/null; fail "peers failed to meet at fallback"; }
  wait "$sender" && wait "$receiver" || fail "fallback transfer failed"
}
export STUB_RELAY_WAITING=push
transport_pair
pass "reachable sender follows timed-out receiver to the same fallback"
export STUB_RELAY_WAITING=pull STUB_RELAY_STDERR=1
transport_pair
pass "reachable receiver follows timed-out sender to the same fallback"
unset STUB_RELAY_WAITING
: > "$W/relays"
export STUB_RELAY_ERROR='could not secure channel'
if "$share" push --friend bob "$W/d/hi.md" >/dev/null 2>&1; then fail "unrelated push error hidden"; fi
if "$share" pull --friend bob --dest "$W/d" --quiet >/dev/null 2>&1; then fail "unrelated pull error hidden"; fi
[ "$(wc -l < "$W/relays")" -eq 2 ] || fail "unrelated errors must not trigger fallback"
pass "unrelated croc errors fail without fallback"
unset STUB_RELAY_ERROR STUB_RELAY_STDERR
: > "$W/relays"
export SHARE_RELAY=private.example:9009 CROC_RELAY=ignored.example:9009 STUB_EXPECT_RELAY=private.example:9009
"$share" push --friend bob "$W/d/hi.md" >/dev/null 2>&1 || fail "SHARE_RELAY push pin"
"$share" pull --friend bob --dest "$W/d" --quiet >/dev/null 2>&1 || fail "SHARE_RELAY pull pin"
[ "$(wc -l < "$W/relays")" -eq 2 ] || fail "explicit pin retried unexpectedly"
grep -q 'push .*--relay private.example:9009' "$W/relays" && grep -q 'pull .*--relay private.example:9009' "$W/relays" || fail "pin precedence"
unset SHARE_RELAY
export STUB_EXPECT_RELAY="$CROC_RELAY"
"$share" push --friend bob "$W/d/hi.md" >/dev/null 2>&1 || fail "CROC_RELAY push pin"
"$share" pull --friend bob --dest "$W/d" --quiet >/dev/null 2>&1 || fail "CROC_RELAY pull pin"
pass "both wrappers honor SHARE_RELAY then CROC_RELAY"
export STUB_PIN_FAIL=1
if "$share" push --friend bob "$W/d/hi.md" >/dev/null 2>&1; then fail "pinned push error hidden"; fi
if "$share" pull --friend bob --dest "$W/d" --quiet >/dev/null 2>&1; then fail "pinned pull error hidden"; fi
pass "unreachable explicit pins fail without switching relays"
unset TMPDIR STUB_MODE STUB_RELAY_LOG SHARE_RELAY_WAIT CROC_RELAY STUB_EXPECT_RELAY STUB_PIN_FAIL
rm -rf "$W"

# 1. a 20s transfer under a 4s waiting cap: must complete in one go
start transfer SHARE_PUSH_MAX=4 SHARE_RELAY_WAIT=2 STUB_DURATION=20
until_ok 10 sh -c "TMPDIR='$W/t' XDG_CONFIG_HOME='$W/cfg' '$share' sync status | grep -q ' sending .*push sending for'" || fail "sending verdict during a transfer: $(S status)"
pass "verdict 'sending' while bytes move"
until_ok 15 test -f "$W/t/share-sync-bob.pushlog" || fail "push log exists while a push is open"
[ "$(stat -c %a "$W/t/share-sync-bob.pushlog" 2>/dev/null || stat -f %Lp "$W/t/share-sync-bob.pushlog")" = 600 ] || fail "push log (holds today's code) must be owner-only"
pass "push log is owner-only (it holds today's code)"
until_ok 40 grep -q 'pushed [0-9a-f]* (.*) in [0-9]' "$W/t/share-sync-bob.log" || fail "long transfer never completed"
[ "$(logs 'push reopened')" = 0 ] || fail "a transfer in flight was reopened by the waiting cap"
pass "20s transfer past a 4s cap completes, never reopened"
S check --friend bob >/dev/null || fail "check exits 0 after delivery: $(S check --friend bob)"
pass "check healthy after delivery"
stop

# 2. the peer never connects: the waiting cap still applies
start wait SHARE_PUSH_MAX=4
until_ok 20 grep -q 'push reopened — waited .* > cap' "$W/t/share-sync-bob.log" || fail "waiting push not reopened at the cap"
pass "waiting push still reopened at the cap"
stop

# 3. connected, then no progress: reopened as a stall, and the reopen is not counted as delivered
start stall SHARE_PUSH_MAX=4 SHARE_PUSH_STALL=5
until_ok 25 grep -q 'push reopened — transfer stalled — no progress' "$W/t/share-sync-bob.log" || fail "stalled transfer not reopened"
pass "stalled transfer reopened"
[ ! -f "$W/d/.share/peer/bob.sent" ] || fail "stalled push must not count as delivered"
pass "stalled push not marked sent"
echo "all watchdog checks passed"
