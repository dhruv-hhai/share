#!/usr/bin/env bash
# Pure register algebra, including a seeded corpus; no transport or git.
set -euo pipefail
for i in 1 2 3 4 5 6; do "$BASH" "$(dirname "$0")/sync-locks" > /tmp/lk 2>&1 || { cat /tmp/lk; exit 1; }; done; echo locks x6 ok
for i in 1 2 3 4 5 6; do "$BASH" "$(dirname "$0")/sync-ledger" > /tmp/lg 2>&1 || { cat /tmp/lg; exit 1; }; done; echo ledger x6 ok
sync_lib="$(cd "$(dirname "$0")/../lib" && pwd)"
# shellcheck source=../lib/sync-state.sh
. "$sync_lib/sync-state.sh"
# shellcheck source=../lib/sync-files.sh
. "$sync_lib/sync-files.sh"
w="$(mktemp -d)"; trap 'rm -rf "$w"' EXIT
check() {
  sync_merge "$w/a" "$w/b" > "$w/ab"
  sync_merge "$w/b" "$w/a" > "$w/ba"; cmp "$w/ab" "$w/ba"
  sync_merge "$w/a" "$w/a" > "$w/aa"; cmp "$w/a" "$w/aa"
  sync_merge "$w/ab" "$w/c" > "$w/left"
  sync_merge "$w/b" "$w/c" > "$w/bc"
  sync_merge "$w/a" "$w/bc" > "$w/right"; cmp "$w/left" "$w/right"
}
printf 'p\tx\t-\ta:1\n' > "$w/a"
printf 'p\tx\t-\tb:1\n' > "$w/b"
printf 'p\ty\t-\ta:1,b:1\n' > "$w/c"
check; cmp "$w/c" "$w/left"
[ "$(wc -l < "$w/ab")" -eq 2 ] # same bytes, independent causality
printf 'p\t-\t-\ta:2\n' > "$w/b"
sync_merge "$w/a" "$w/b" > "$w/result"; cmp "$w/b" "$w/result"
printf 'p\tz\t-\ta:3\n' > "$w/c"
check; cmp "$w/c" "$w/left" # resurrection
printf 'p\t-\t-\tb:1\n' > "$w/c"
check # concurrent deletes, concurrent edit/delete
# Fixed three-way concurrency and deterministic materialization from either
# replica, including edit-over-delete and identical-content visibility.
printf 'p\tx\t-\ta:1\n' > "$w/a"
printf 'p\ty\t-\tb:1\n' > "$w/b"
printf 'p\tz\t-\tc:1\n' > "$w/c"
check; [ "$(wc -l < "$w/left")" -eq 3 ]
state="$w/state"; mkdir -p "$state"; cp "$w/left" "$state/manifest"
make_view > "$w/view-a"; sync_merge "$w/c" "$w/ab" > "$state/manifest"
make_view > "$w/view-b"; cmp "$w/view-a" "$w/view-b"
printf 'p\t-\t-\ta:1\np\tx\t-\tb:1\n' > "$state/manifest"
[ "$(make_view)" = $'p\tx' ]
printf 'p\tx\t-\ta:1\np\tx\t-\tb:1\n' > "$state/manifest"
[ "$(make_view)" = $'p\tx' ]
[ "$(sync_conflict_name dir/notes.md abcdef1234)" = dir/notes.conflict-abcdef12.md ]
[ "$(sync_conflict_name .config abcdef1234)" = .config.conflict-abcdef12 ]
printf 'p\tx\t-\ta:2,b:1\np\ty\t-\tb:3\n' | sync_clock c > "$w/clock"
[ "$(cat "$w/clock")" = a:2,b:3,c:1 ]
# A portable explicit LCG avoids awk implementations' different srand streams.
awk 'BEGIN{s=71237; for(t=1;t<=300;t++)for(f=1;f<=3;f++)for(i=1;i<=5;i++){
 s=(s*16807)%2147483647; a=s%5; s=(s*16807)%2147483647; b=s%5;
 s=(s*16807)%2147483647; h=s%4;
 printf "%d\t%d\tp%d\t%s\t-\ta:%d,b:%d\n",t,f,i%2,(h==0?"-":h),a,b}}' > "$w/corpus"
for t in $(seq 1 300); do
  for f in 1 2 3; do
    awk -F '\t' -v t="$t" -v f="$f" '$1==t&&$2==f{sub(/^[^\t]*\t[^\t]*\t/,"");print}' "$w/corpus" > "$w/raw"
    case "$f" in 1) dest=a;; 2) dest=b;; 3) dest=c;; esac
    sync_merge "$w/raw" > "$w/$dest"
  done
  check
done
echo 'merge: fixed regressions and 300 seeded algebra triples passed'
