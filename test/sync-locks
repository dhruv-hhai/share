#!/usr/bin/env bash
# same-host lock tool: mutual exclusion, killed holders, --wait timeout, exit codes, ledger chain.
# usage: test/sync-locks        (~5s)
set -uo pipefail
repo="$(cd "$(dirname "$0")/.." && pwd)"; lock="$repo/tools/lock"
pass() { echo "  ok  $*"; }
fail() { echo "FAIL  $*" >&2; exit 1; }
w="$(mktemp -d)"; trap 'rm -rf "$w"' EXIT
mkdir -p "$w/.share"; echo r1 > "$w/.share/replica"

echo "share lock (same host)"

# 1. three contenders on one name never interleave
for _ in 1 2 3; do "$lock" x --dir "$w" -- sh -c 'echo start >> "$1"; sleep 0.5; echo end >> "$1"' sh "$w/log" & done
wait || fail "a contender failed"
[ "$(paste -sd' ' "$w/log")" = "start end start end start end" ] || fail "interleaved: $(paste -sd' ' "$w/log")"
flock -n "$w/.share/locks/x" true || fail "lock still held after all holders exited"
pass "concurrent holders never interleave, lock released"

# 2. a SIGKILLed holder frees the lock at once; its command does not inherit it
"$lock" k --dir "$w" -- sh -c 'echo $$ > "$1"; exec sleep 30' sh "$w/kpid" & k=$!
i=0; until [ -s "$w/kpid" ] || [ "$i" -ge 50 ]; do sleep 0.1; i=$((i+1)); done
kill -9 "$k"; wait "$k" 2>/dev/null
"$lock" k --dir "$w" --wait 2 -- true; rc=$?
kill "$(cat "$w/kpid")" 2>/dev/null
[ "$rc" = 0 ] || fail "lock of a killed holder not free (exit $rc)"
pass "killed holder releases the lock; its orphaned command holds nothing"

# 3. a live holder with --wait 1 gives up with exit 3
"$lock" h --dir "$w" -- sleep 3 & holder=$!
i=0; until [ -s "$w/.share/locks/h" ] || [ "$i" -ge 50 ]; do sleep 0.1; i=$((i+1)); done
"$lock" h --dir "$w" --wait 1 -- true; rc=$?
wait "$holder"
[ "$rc" = 3 ] || fail "--wait against a live holder exited $rc, want 3"
pass "--wait timeout exits 3"

# 4. the command's exit code propagates and the lock is released
"$lock" f --dir "$w" -- false; rc=$?
[ "$rc" = 1 ] || fail "false exited $rc, want 1"
flock -n "$w/.share/locks/f" true || fail "lock not released after failing command"
pass "command exit code propagates"

# 5. ledger gets lock then unlock, chained, 7+ columns
"$lock" led --dir "$w" --writer tester -- true || fail "ledger run failed"
f="$w/.share/ledger/r1/tester.log"
awk -F '\t' '
  NR==1 { if ($5 != "lock" || $4 != "r1/tester" || $6 != "lock:led" || NF < 7 || $2 != "-") bad=1; a=$1 }
  NR==2 { if ($5 != "unlock" || NF < 7 || $2 != a) bad=1 }
  END   { exit (NR == 2 && !bad) ? 0 : 1 }' "$f" || fail "ledger lines wrong: $(cat "$f")"
pass "ledger records lock then unlock with a hash chain"

# 6. bad names are refused
"$lock" '../x' --dir "$w" -- true 2>/dev/null; rc=$?
[ "$rc" = 2 ] || fail "lock name '../x' accepted (exit $rc)"
pass "lock names with path parts are refused"

echo "all lock checks passed"
