#!/usr/bin/env bash
# stub croc: mimics croc's sender stderr ("Sending 'f' (size)", then "\nSending (->ip)" when the peer connects,
# then \r progress lines). Behaviour from env: STUB_MODE=wait (peer never comes) | transfer | stall
#   STUB_CONNECT_AFTER  seconds before the peer "connects" (default 1)
#   STUB_DURATION       seconds of progress for transfer mode (default 20)
[ "${1:-}" = --version ] && { echo "croc stub"; exit 0; }
if [ "${STUB_MODE:-}" = relay ]; then
  direction=pull; case " $* " in *" send "*) direction=push;; esac
  printf '%s %s\n' "$direction" "$*" >> "$STUB_RELAY_LOG"
  relay=""; while [ $# -gt 0 ]; do case "$1" in --relay) relay="$2"; shift;; esac; shift; done
  if [ -n "$relay" ]; then
    [ "$relay" = "${STUB_EXPECT_RELAY:-croc.schollz.com:9009}" ] || exit 2
    [ "${STUB_PIN_FAIL:-0}" != 1 ] || { echo 'could not connect to pinned: i/o timeout'; exit 1; }
    # A common room verifies that the waiting peer follows the unreachable one.
    if [ -n "${STUB_RELAY_ROOM:-}" ]; then
      touch "$STUB_RELAY_ROOM/$direction"
      while [ ! -f "$STUB_RELAY_ROOM/push" ] || [ ! -f "$STUB_RELAY_ROOM/pull" ]; do sleep 0.1; done
    fi
    exit 0
  fi
  if [ "${STUB_RELAY_WAITING:-}" = "$direction" ]; then
    while :; do sleep 0.1; done
  fi
  if [ "${STUB_RELAY_STDERR:-0}" = 1 ]; then
    echo "${STUB_RELAY_ERROR:-could not connect to relay.example:9009: dial tcp: i/o timeout}" >&2
  else echo "${STUB_RELAY_ERROR:-could not connect to relay.example:9009: dial tcp: i/o timeout}"; fi
  exit 1
fi
if [ "${STUB_MODE:-}" = pullfail ]; then
  case " $* " in
    *" send "*) while :; do sleep 1; done;;
    *) [ -f "$TMPDIR/pull-recovered" ] && exit 0; echo 'relay unavailable'; exit 1;;
  esac
fi
if [ "${STUB_MODE:-}" = queue ]; then
  room="$STUB_QUEUE/$CROC_SECRET"; mkdir -p "$room"
  case " $* " in
    *" send "*)
      for file in "$@"; do :; done
      while [ -e "$room/ready" ]; do sleep 0.1; done
      if [ -f "$STUB_QUEUE/drop" ]; then rm -f "$STUB_QUEUE/drop"; exit 0; fi
      cp "$file" "$room/payload.new" || exit 1
      printf '%s\n' "${file##*/}" > "$room/name"
      mv "$room/payload.new" "$room/payload"
      if [ -f "$STUB_QUEUE/duplicate" ]; then cp "$room/payload" "$room/again"; rm -f "$STUB_QUEUE/duplicate"; fi
      touch "$room/ready"
      printf '\nSending (->stub)\n' >&2
      while [ -e "$room/ready" ]; do printf '\r transferring' >&2; sleep 0.1; done
      exit 0;;
    *)
      while [ ! -f "$room/ready" ]; do sleep 0.1; done
      while [ -f "$STUB_QUEUE/pause" ]; do sleep 0.1; done
      cp "$room/payload" "$(cat "$room/name")" || exit 1
      if [ -f "$room/again" ]; then mv "$room/again" "$room/payload"; else rm -f "$room/ready"; fi
      exit 0;;
  esac
fi
case " $* " in
  *" send "*)
    echo "Sending 'share-sync-v1.bundle' (1.0 MB)" >&2
    echo "Code is: $CROC_SECRET" >&2
    mode="${STUB_MODE:-transfer}"
    if [ "$mode" = wait ]; then while :; do sleep 1; done; fi
    sleep "${STUB_CONNECT_AFTER:-1}"
    printf '\nSending (->127.0.0.1:9009)\n' >&2
    if [ "$mode" = stall ]; then printf '\r share-sync-v1.bundle   3%%\n' >&2; while :; do sleep 1; done; fi
    n="${STUB_DURATION:-20}"
    for i in $(seq 1 "$n"); do printf '\r share-sync-v1.bundle %3d%%' $((i * 100 / n)) >&2; sleep 1; done
    printf '\n' >&2; exit 0;;
  *)  # receive: nobody is sending to us in these tests
    echo "waiting for sender" >&2; while :; do sleep 1; done;;
esac
