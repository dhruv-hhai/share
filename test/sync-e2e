#!/usr/bin/env bash
# sync end-to-end: two daemons (alice role a, bob role b) on one machine over a local relay.
# Covers: round trip both ways, status/check verdicts, saved-config restart, check --repair,
# edits committed while a push is blocked, watchdog push cap, stale-lock break, loop respawn.
# usage: CROC_RELAY=localhost:9009 test/sync-e2e [WORKDIR]     (needs croc + git; ~2-3 min)
set -euo pipefail
share="$(cd "$(dirname "$0")/.." && pwd)/share"
W="${1:-$(mktemp -d)}"; mkdir -p "$W"/{a,b,ta,tb,cfg}
export XDG_CONFIG_HOME="$W/cfg" SHARE_SECRET_ALICE="e2e-sync-$$" SHARE_SECRET_BOB="e2e-sync-$$"
export SHARE_AUTO_UPDATE=0 SHARE_FOLLOW_EVERY=2   # no network/brew from the daemons; version-follow every 2s instead of 60
export SHARE_DISK_RESERVE_MB=64 SHARE_SYNC_HEARTBEAT=10
repo="$(cd "$(dirname "$0")/.." && pwd)"; e2etag="v99.99.99-e2e"
A() { TMPDIR="$W/ta" "$share" sync "$@"; }      # alice's machine: friend = bob, role a, dir $W/a
B() { TMPDIR="$W/tb" "$share" sync "$@"; }      # bob's machine:   friend = alice, role b, dir $W/b
until_ok() { local n="$1"; shift; for _ in $(seq 1 "$n"); do "$@" 2>/dev/null && return 0; sleep 1; done; echo "TIMEOUT after ${n}s: $*" >&2; return 1; }
pass() { echo "  ok  $*"; }
fail() { echo "FAIL  $*" >&2; echo "--- alice log"; cat "$W/ta/share-sync-bob.log" 2>/dev/null; echo "--- bob log"; cat "$W/tb/share-sync-alice.log" 2>/dev/null; exit 1; }
cleanup() { A stop --friend bob >/dev/null 2>&1 || true; B stop --friend alice >/dev/null 2>&1 || true; git -C "$repo" tag -d "$e2etag" >/dev/null 2>&1 || true; }
trap cleanup EXIT

echo "sync e2e in $W (relay ${CROC_RELAY:-default})"
SHARE_PUSH_MAX=8 A --friend bob --role a --dir "$W/a" --every 2 >/dev/null
B --friend alice --role b --dir "$W/b" --every 2 >/dev/null
echo "hello from alice" > "$W/a/hi.md"
until_ok 90 test -f "$W/b/hi.md" || fail "a→b round trip"; pass "a→b round trip"
echo "hello from bob" > "$W/b/re.md"
until_ok 90 test -f "$W/a/re.md" || fail "b→a round trip"; pass "b→a round trip"

A status | grep -E '^bob +role a +(ok|waiting-peer|sending) ' || fail "status verdict: $(A status)"; pass "status shows a healthy verdict"
until_ok 30 A check --friend bob >/dev/null || fail "check exit 0 when healthy"; pass "check --friend exits 0 when healthy"
grep -q '^a 2 ' "$W/cfg/share/sync/bob" || fail "saved config: $(cat "$W/cfg/share/sync/bob")"; pass "config saved (role every dir)"

# Peer manifests are bandwidth hints; large files are called out during scan.
until_ok 30 test -f "$W/a/.share/peer/bob.manifest" || fail "peer manifest after a pull"; pass "peer manifest recorded on pull"
echo "third exchange" > "$W/a/three.md"
until_ok 180 test -f "$W/b/three.md" || fail "a→b third exchange"
grep -q 'pushed [0-9a-f]* ([0-9]*KB)' "$W/ta/share-sync-bob.log" || fail "push log"; pass "manifest pushes recorded"
dd if=/dev/zero of="$W/a/blob.bin" bs=1048576 count=21 2>/dev/null
until_ok 120 grep -q 'large file 21MB: blob.bin' "$W/ta/share-sync-bob.log" || fail "large file warning"; pass "large file warned at commit"
until_ok 180 test -f "$W/b/blob.bin" || fail "large file delivered"
[ ! -d "$W/b/.git" ] || fail "v2 created .git"; pass "no git object store"
A status | grep -qE 'disk|DISK' && pass "status reports disk use" || pass "status: disk under 80%, nothing to report"

# bob offline: alice's push blocks at the relay; her edits must still get committed; the watchdog must reopen the push past the cap
B stop --friend alice >/dev/null
echo "written while bob is offline" > "$W/a/offline.md"
until_ok 30 grep -q '^offline.md' "$W/a/.share/manifest" || fail "edit versioned while push blocked"; pass "edit versioned while push blocked (scan tick)"
until_ok 60 bash -c "TMPDIR='$W/ta' '$share' sync check --friend bob | grep 'waiting-peer.*push waiting.*pending'" || fail "waiting-peer verdict: $(A check --friend bob)"
pass "verdict waiting-peer with push age + pending count"
until_ok 60 grep -q 'push reopened — waited .* > cap' "$W/ta/share-sync-bob.log" || fail "watchdog push cap"; pass "watchdog reopened a push past the cap"
! cmp -s "$W/a/.share/peer/bob.pushed" "$W/a/.share/manifest" || fail "reopen must not count as pushed"; pass "reopened push not marked sent"
grep -q 'Terminated' "$W/ta/share-sync-bob.log" && fail "bash kill noise in log"; pass "no kill noise in log"

# Own the injected lock before aging it. mkdir -p could reuse a live loop's
# lock, which that loop would normally remove before recovery ever saw it.
until_ok 30 mkdir "$W/ta/share-sync-bob.gitlock" || fail "acquire stale-lock fixture"
touch -t "$(date -v-20M +%Y%m%d%H%M 2>/dev/null || date -d '-20 min' +%Y%m%d%H%M)" "$W/ta/share-sync-bob.gitlock"
until_ok 30 grep -q 'broke a stale lock' "$W/ta/share-sync-bob.log" || fail "stale lock break"; pass "stale lock broken"

# a loop that dies is respawned, daemon stays up
read -r apid _ < "$W/ta/share-sync-bob.pid"
loop="$(pgrep -P "$apid" -f 'tools/sync' | head -1)"; kill -9 "$loop"
until_ok 30 grep -q 'loop died — respawning' "$W/ta/share-sync-bob.log" || fail "loop respawn"; pass "dead loop respawned"
kill -0 "$apid" || fail "daemon exited on loop death"

# bob back from saved config (no --role): the queued push lands
B --friend alice >/dev/null
until_ok 120 test -f "$W/b/offline.md" || fail "queued push delivered after peer returns"; pass "peer restarted from saved config, queued push delivered"

# restart + check --repair
A restart --friend bob >/dev/null; sleep 1
until_ok 30 A check --friend bob >/dev/null || fail "healthy after restart"; pass "restart from saved config"
A stop --friend bob >/dev/null
if A check --friend bob >/dev/null; then fail "check should exit 1 when down"; fi; pass "check exits 1 when down"
A check --friend bob --repair | grep -q 'repaired bob' || fail "check --repair"; sleep 1
until_ok 30 A check --friend bob >/dev/null || fail "healthy after --repair"; pass "check --repair restarted it"
# the installed version changes under a running daemon (git install: a new tag) → it re-execs onto it, same pid
read -r apid _ < "$W/ta/share-sync-bob.pid"
git -C "$repo" tag "$e2etag" >/dev/null
until_ok 30 grep -q 're-exec onto the installed version' "$W/ta/share-sync-bob.log" || fail "version follow re-exec"; pass "daemon re-execs when installed version changes"
sleep 2; read -r apid2 _ < "$W/ta/share-sync-bob.pid"; [ "$apid" = "$apid2" ] || fail "re-exec changed the pid ($apid -> $apid2)"; pass "re-exec keeps the pid"
until_ok 30 A check --friend bob >/dev/null || fail "healthy after re-exec"; pass "healthy after re-exec"
grep -q "share 99.99.99-e2e" "$W/ta/share-sync-bob.log" || fail "new daemon did not report the new version"; pass "new version reported in log"
echo "sync e2e: all passed"
