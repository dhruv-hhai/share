#!/usr/bin/env bash
# shellcheck disable=SC2154,SC2034
# Exercise the actual filesystem engine without a transport or daemon.
# Negative checks use if/exit: set -e ignores a failing `! cmd`.
set -euo pipefail
export LC_ALL=C
sync_lib="$(cd "$(dirname "$0")/../lib" && pwd)"
# shellcheck source=../lib/sync-state.sh
. "$sync_lib/sync-state.sh"
# shellcheck source=../lib/sync-files.sh
. "$sync_lib/sync-files.sh"
# shellcheck source=../lib/sync-payload.sh
. "$sync_lib/sync-payload.sh"
w="$(mktemp -d)"; trap 'rm -rf "$w"' EXIT
log() { echo "$*" >&2; }
# Receive PAYLOAD into a fresh state, in a subshell; tar's stderr goes to $w/recv.err.
receive_quiet() {
  ( d="$(mktemp -d "$w/recv.XXXXXX")"; f=peer; init_state && receive_payload "$1" ) 2>"$w/recv.err"
}
d="$w/a"; f=b; mkdir -p "$d"; init_state
echo original > "$d/hello.txt"; scan; retain_blobs
test "$(wc -l < "$state/manifest")" -eq 1
bd="$w/out"; bf="$bd/share-sync-v2.tar"; mkdir -p "$bd"; make_payload
d="$w/b"; f=a; mkdir -p "$d"; init_state
receive_payload "$bf"; cmp "$w/a/hello.txt" "$w/b/hello.txt"
echo edited > "$d/hello.txt"; scan
rm "$d/hello.txt"; scan
grep -q $'hello.txt\t-\t' "$state/manifest"
echo resurrected > "$d/hello.txt"; scan
test "$(wc -l < "$state/manifest")" -eq 1
echo 'filesystem: initial transfer, edit, delete, resurrection passed'
# A local edit made after an incoming merge but before apply is concurrent,
# rather than a causal successor of unseen incoming bytes.
old_manifest="$w/b-before"; cp "$state/manifest" "$old_manifest"
echo remote > "$state/snapshot"; h="$(hash_file "$state/snapshot")"; cp "$state/snapshot" "$state/blobs/$h"
oldh="$(cut -f2 "$old_manifest")"; vv="$(sync_clock abcdef < "$old_manifest")"
printf 'hello.txt\t%s\t%s\t%s\n' "$h" "$oldh" "$vv" > "$state/incoming"
sync_merge "$state/manifest" "$state/incoming" > "$state/manifest.new"; mv "$state/manifest.new" "$state/manifest"
echo intervening > "$d/hello.txt"
materialize
[ "$(path_entries hello.txt | wc -l)" -eq 2 ]
grep -rl intervening "$d" --exclude-dir=.share >/dev/null
grep -rl remote "$d" --exclude-dir=.share >/dev/null
echo 'filesystem: mid-apply edit and incoming content both preserved'
# Missing and corrupt blobs never create an unmaterializable manifest entry.
mkdir -p "$w/payload/blobs" "$w/payload/base"
printf '2\n' > "$w/payload/version"; echo abcdef > "$w/payload/replica"
printf 'missing.bin\t%064d\t-\tabcdef:1\n' 1 > "$w/payload/manifest"
tar -cf "$w/missing.tar" -C "$w/payload" version replica manifest blobs base
receive_payload "$w/missing.tar"
if grep -q missing.bin "$state/manifest"; then echo 'assertion failed: grep -q missing.bin "$state/manifest"' >&2; exit 1; fi
echo corrupt > "$w/payload/blobs/$(printf '%064d' 1)"
tar -cf "$w/corrupt.tar" -C "$w/payload" version replica manifest blobs base
if receive_payload "$w/corrupt.tar"; then echo 'corrupt blob accepted' >&2; exit 1; fi
echo 'filesystem: missing and corrupt blobs refused'
# Content members are unpacked in one pass; anything but a plain regular file
# is refused unread, even a link whose target has the advertised hash.
rm -f "$w/payload/blobs"/*; h1="$(hash_file "$w/a/hello.txt")"
ln -s "$w/a/hello.txt" "$w/payload/blobs/$h1"
printf 'link.txt\t%s\t-\tabcdef:1\n' "$h1" > "$w/payload/manifest"
tar -cf "$w/link.tar" -C "$w/payload" version replica manifest blobs base
if receive_payload "$w/link.tar"; then echo 'symlink member accepted' >&2; exit 1; fi
if grep -q link.txt "$state/manifest"; then echo 'assertion failed: grep -q link.txt "$state/manifest"' >&2; exit 1; fi
rm -f "$w/payload/blobs/$h1"; mkfifo "$w/payload/blobs/$h1"
tar -cf "$w/fifo.tar" -C "$w/payload" version replica manifest blobs base
if receive_payload "$w/fifo.tar"; then echo 'fifo member accepted' >&2; exit 1; fi
if grep -q link.txt "$state/manifest"; then echo 'assertion failed: grep -q link.txt "$state/manifest"' >&2; exit 1; fi
rm -f "$w/payload/blobs/$h1"
echo 'filesystem: link and fifo members refused unread'
d="$w/safety"; mkdir -p "$d/ignored"; init_state
printf '*.secret\nignored/\n' > "$d/.shareignore"
echo skip > "$d/token.secret"; echo skip > "$d/ignored/file"
echo skip > "$d/.DS_Store"
echo keep > "$d/name with spaces.txt"; echo keep > "$d/back\\slash.txt"
echo skip > "$d/"$'tab\tname'; echo skip > "$d/"$'line\nname'
ln -s "$w/a/hello.txt" "$d/link"
scan; scan
[ "$(wc -l < "$state/manifest")" -eq 3 ]
grep -F 'back\slash.txt' "$state/manifest" >/dev/null
[ "$(find "$state" -name 'skipped-*' | wc -l)" -eq 2 ]
echo 'filesystem: ignores, spaces/backslashes, unsupported names and symlinks'
printf 'name with spaces.txt\n' >> "$d/.shareignore"
scan; make_payload
tar -xOf "$bf" manifest > "$w/filtered"
if grep -q 'name with spaces.txt' "$w/filtered"; then echo 'assertion failed: grep -q name with spaces.txt "$w/filtered"' >&2; exit 1; fi
grep -q '^.shareignore' "$w/filtered"
echo 'filesystem: new ignores suppress previously tracked outgoing content'
# Extended attributes never become extra payload members (macOS tar would add
# AppleDouble ._* entries, which a Linux peer refuses).
if command -v xattr >/dev/null && xattr -w com.example.share-test 1 "$d/back\\slash.txt" 2>/dev/null; then
  xattr -w com.example.share-test 1 "$state/replica"
  scan; make_payload
  # macOS tar -t hides the ._replica member it writes; look at the raw headers.
  if LC_ALL=C grep -aq '\._replica' "$bf"; then echo 'assertion failed: LC_ALL=C grep -aq \._replica "$bf"' >&2; exit 1; fi
  # Extraction must stay quiet about xattr headers too (GNU tar warns on them).
  receive_quiet "$bf" || { echo 'xattr payload not received' >&2; exit 1; }
  if grep -q 'unknown extended header' "$w/recv.err"; then echo 'assertion failed: unknown extended header on stderr' >&2; exit 1; fi
  echo 'filesystem: xattrs add no payload members or extraction warnings'
fi
# Pruning ignored trees during the walk must sync exactly what per-path
# filtering would, including a root whose name contains glob characters.
d="$w/prune [x]*"; mkdir -p "$d"; init_state
printf '%s\n' 'node_modules/*' '*/node_modules/*' 'build/' 'result-*' '*.log' 'docs/*/tmp*' > "$d/.shareignore"
for p in node_modules/a/x sub/node_modules/b/y build/z build2/keep result-1/q sub/result-2/r \
  keep/node_modules.txt keep/build/k keep/x.log.txt docs/a/tmp1/t docs/a/tmpfile docs/tmp/keep top.txt; do
  mkdir -p "$(dirname "$d/$p")"; echo "$p" > "$d/$p"
done
scan
(cd "$d" && find . -type f ! -path './.share/*' | sed 's|^\./||') | while IFS= read -r p; do
  ignored "$p" || printf '%s\n' "$p"
done | sort > "$w/expected"
cut -f1 "$state/manifest" | sort > "$w/actual"
diff "$w/expected" "$w/actual"
grep -qx build2/keep "$w/actual"; grep -qx keep/build/k "$w/actual"
if grep -q node_modules/ "$w/actual"; then echo "assertion failed: node_modules synced" >&2; exit 1; fi
echo 'filesystem: pruned walk matches per-path ignore filtering'
# A lost local blob never blocks payloads: identical working bytes restore it,
# otherwise that version is left out of the payload instead of failing it.
d="$w/heal"; f=peer; mkdir -p "$d"; init_state
echo keep > "$d/keep.txt"; echo gone > "$d/gone.txt"; scan
hk="$(path_entries keep.txt | cut -f2)"; hg="$(path_entries gone.txt | cut -f2)"
rm "$state/blobs/$hk" "$state/blobs/$hg"; echo changed > "$d/gone.txt"
make_payload 2>/dev/null
[ -f "$state/blobs/$hk" ] && [ "$(hash_file "$state/blobs/$hk")" = "$hk" ]
tar -xOf "$bf" manifest > "$w/heal-manifest"
grep -q "^keep.txt"$'\t'"$hk" "$w/heal-manifest"
if grep -q "$hg" "$w/heal-manifest"; then echo 'unsendable version advertised' >&2; exit 1; fi
echo 'filesystem: missing blobs healed from working files or left out of payloads'
# Lenient receive: an unknown member is skipped and never unpacked, while a
# critical feature this build lacks refuses the whole payload before any change.
d="$w/lenient"; f=peer; mkdir -p "$d"; init_state
lp="$w/lenient-payload"; rm -rf "$lp"; mkdir -p "$lp/blobs" "$lp/base" "$lp/extra"
printf '2\n' > "$lp/version"; echo abcdef > "$lp/replica"; : > "$lp/features"
echo lenient > "$w/lenient-src"; lh="$(hash_file "$w/lenient-src")"; cp "$w/lenient-src" "$lp/blobs/$lh"
printf 'lenient.txt\t%s\t-\tabcdef:1\n' "$lh" > "$lp/manifest"
echo junk > "$lp/extra/junk"
tar -cf "$w/lenient.tar" -C "$lp" version replica manifest features blobs base extra
receive_payload "$w/lenient.tar"
grep -qx lenient "$d/lenient.txt"
echo 'filesystem: unknown payload member skipped and known content applied'
cp "$state/manifest" "$w/critical-before"
printf 'refused.txt\t%s\t-\tabcdef:2\n' "$lh" > "$lp/manifest"
printf 'nope\n' > "$lp/critical"
tar -cf "$w/critical.tar" -C "$lp" version replica manifest features critical blobs base extra
if receive_payload "$w/critical.tar"; then echo 'critical feature accepted' >&2; exit 1; fi
cmp -s "$w/critical-before" "$state/manifest"
[ ! -e "$d/refused.txt" ]
echo 'filesystem: critical feature this build lacks refuses the payload'
# Every payload carries a features member, empty while no feature is advertised.
d="$w/features"; f=peer; mkdir -p "$d"; init_state
echo feature > "$d/feature.txt"; scan
bd="$w/feature-out"; bf="$bd/share-sync-v2.tar"; mkdir -p "$bd"; make_payload
tar -tf "$bf" | grep -qx features
echo 'filesystem: payloads advertise a features member'
# Linux peers must receive without the xattr-header warning. This guards the
# quiet-flag plumbing; GNU tar has no LIBARCHIVE headers, so it passes trivially.
d="$w/quiet"; f=a; mkdir -p "$d"; init_state
echo quiet > "$d/quiet.txt"; scan; make_payload
receive_quiet "$bf" || { echo 'quiet payload not received' >&2; exit 1; }
if grep -q 'Ignoring unknown extended header' "$w/recv.err"; then echo 'assertion failed: Ignoring unknown extended header on stderr' >&2; exit 1; fi
echo 'filesystem: payload receive prints no tar extended-header warnings'
# Per-path .sharemerge strategies; run here so CI picks them up with this suite.
"$BASH" "$(dirname "$0")/sync-strategies"
# Ledger, writers, leases and locks suites; run here so CI covers them with this suite.
for t in sync-ledger sync-writers sync-leases sync-locks; do "$BASH" "$(dirname "$0")/$t"; done
